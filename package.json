{
  "name": "assurerail",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone AssureRail transaction infrastructure repository.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@assurerail/api && npm run build --workspace=@assurerail/web",
    "test": "npm test --workspace=@assurerail/api",
    "check": "bash scripts/assurerail-integrated-release-check.sh",
    "db:migrate:deploy": "npm run db:migrate --workspace=@assurerail/api",
    "security:deps": "node scripts/assurerail-sec01-dependency-audit.mjs",
    "security:azure": "node scripts/check-assurerail-azure-baseline.mjs",
    "security:e2e:list": "playwright test --config=playwright.assurerail.config.ts --list",
    "security:e2e": "node scripts/assurerail-sec01-e2e-preflight.mjs && playwright test --config=playwright.assurerail.config.ts",
    "ux:source": "npm run check:user-errors --workspace=@assurerail/web",
    "ux:e2e:list": "playwright test --config=playwright.assurerail-ux.config.ts --list",
    "ux:e2e": "node scripts/assurerail-ux-e2e-preflight.mjs && playwright test --config=playwright.assurerail-ux.config.ts",
    "security:dast": "bash scripts/assurerail-sec01-dast.sh",
    "demo:check": "npm run check:demo-access --workspace=@assurerail/web && npm run check:ar-demo01 --workspace=@assurerail/web",
    "demo:preflight": "bash scripts/assurerail-demo-preflight.sh --source",
    "demo:browser": "npm run check:ar-demo01-browser --workspace=@assurerail/web",
    "demo:prospect:credentials": "node scripts/assurerail-prospect-demo-credentials.mjs",
    "demo:prospect:preflight": "node scripts/assurerail-prospect-demo-preflight.mjs",
    "demo:prospect:record": "node docs/demo/assurerail/mini-demo/record.mjs",
    "pilot:check": "node scripts/assurerail-pilot-readiness-pack-check.mjs",
    "security:offline-daily": "bash scripts/assurerail-offline-security-daily.sh",
    "policy:generate": "node scripts/generate-assurerail-commercial-policy.mjs",
    "policy:check": "node scripts/generate-assurerail-commercial-policy.mjs --check && node scripts/check-assurerail-commercial-policy.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.2.0"
}
