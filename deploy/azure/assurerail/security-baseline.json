{
  "schemaVersion": 1,
  "baselineId": "ASSURERAIL-AZURE-INDIA-SEC-01",
  "status": "TARGET_NOT_DEPLOYED",
  "approvedOn": null,
  "geography": "India",
  "regions": {
    "primary": {
      "azureName": "indiasouthcentral",
      "displayName": "India South Central",
      "city": "Hyderabad",
      "availabilityZonesRequired": true
    },
    "recovery": {
