  "resilience": {
    "documentedRtoRpoRequired": true,
    "quarterlyRestoreTestRequired": true,
    "annualRegionalFailoverExerciseRequired": true,
    "providerReconciliationAfterRecoveryRequired": true,
    "manualSafePauseRequired": true,
    "failbackPlanRequired": true
  },
  "securityTesting": {
    "dependencyGate": "NO_CRITICAL_OR_HIGH",
    "sastAndSecretScanRequired": true,
    "authenticatedE2eRequired": true,
    "authenticatedDastRequired": true,
    "independentVaptRequiredBeforeControlledLive": true,
    "vaptRetestRequiredForMaterialFindings": true
