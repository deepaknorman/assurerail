# Non-secret effective deployment contract for the current inert demo. Copy outside the repository,
# replace ASSURERAIL_BUILD_COMMIT with the exact signed release SHA, and add secrets through the
# approved runtime secret channel. The pre-deployment gate reads values but never prints them.
NODE_ENV=production
ASSURERAIL_OPERATING_MODE=DEMO
ASSURERAIL_BUILD_COMMIT=0000000000000000000000000000000000000000
ASSURERAIL_CORS_ANY=false
ARAIL_DEMO_ENDPOINTS_ENABLED=true

TAPE_SOURCE=demo
HTS_ADAPTER=demo
HCS_ANCHOR=demo
SETTLEMENT_ADAPTER=demo
DIGIKYC_GATE=demo
SEED_ON_BOOT=true

ARAIL_NEUTRAL_TAXONOMY_V1=off
ARAIL_NEUTRAL_INGRESS_V1=off
ARAIL_TRANSACTION_CASE_V1=off
ARAIL_EXTERNAL_ACTION_SAGA_V1=off
ARAIL_DA_REPLAY_V1=off
ARAIL_PTC_REPLAY_V1=off
ARAIL_DURABLE_RELAY_MODE=legacy
ARAIL_PARTICIPANT_ADMISSION_V1=off
ARAIL_ROUTE_ENTITLEMENT_ENFORCE=off
ARAIL_ROOM_READ_SOURCE=legacy
ARAIL_ROOM_WRITE_SOURCE=legacy
ARAIL_COMPLETION_ACK_V1=off
ARAIL_LEGACY_ROOM_PROXY_V1=off
ARAIL_TOKENISED_DA_V1=off
ARAIL_TOKENISED_PTC_V1=off
ARAIL_PRIMARY_COMMERCIAL_V1=off
ARAIL_CONVENTIONAL_SECONDARY_V1=off
ARAIL_VENUE_CONDUCT_V1=off
ARAIL_DEVELOPER_PORTAL_V1=off
ARAIL_CUSTOMER_OPERATIONS_V1=off
ARAIL_HOSTED_ALPHA_V1=off
ARAIL_INSTITUTIONAL_PRODUCT_V1=off
ARAIL_DA_PRODUCT_V1=off
ARAIL_PTC_PRODUCT_V1=off
ARAIL_LIFECYCLE_PRODUCT_V1=off
ARAIL_PRIMARY_VENUE_PRODUCT_V1=off
ARAIL_SECONDARY_PRODUCT_V1=off
ARAIL_TOKENISED_PRODUCT_V1=off
ARAIL_ENTERPRISE_INTEGRATION_V1=off
ARAIL_PRODUCTION_SCALE_V1=off
ARAIL_INTERNAL_RBAC_V1=off

NEXT_PUBLIC_ASSURERAIL_CUSTOMER_WORKSPACE_V1=off
NEXT_PUBLIC_ASSURERAIL_CUSTOMER_OPERATIONS_V1=off
NEXT_PUBLIC_ASSURERAIL_HOSTED_ALPHA_V1=off
NEXT_PUBLIC_ASSURERAIL_INSTITUTIONAL_PRODUCT_V1=off
NEXT_PUBLIC_ASSURERAIL_DA_PRODUCT_V1=off
NEXT_PUBLIC_ASSURERAIL_PTC_PRODUCT_V1=off
