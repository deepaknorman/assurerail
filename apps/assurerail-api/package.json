{
  "name": "@code/assurerail-api",
  "version": "0.1.0",
  "private": true,
  "description": "AssureRail venue — securitisation & tokenisation. Separate app in the monorepo (own DB / env / ports / access management), like plaza / plaza-api. Splits to its own repo at the incorporation trigger.",
  "scripts": {
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc --noEmit",
    "start": "node dist/main.js",
    "check": "bash ../../scripts/assurerail-build-check.sh",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:rehearse:pr02": "bash ../../scripts/assurerail-pr02-db-rehearsal.sh",
    "db:rehearse:pr03": "bash ../../scripts/assurerail-pr03-db-rehearsal.sh",
    "db:rehearse:pr05": "bash ../../scripts/assurerail-pr05-db-rehearsal.sh",
    "db:rehearse:pr06": "bash ../../scripts/assurerail-pr06-db-rehearsal.sh",
    "db:rehearse:pr07": "bash ../../scripts/assurerail-pr07-db-rehearsal.sh",
    "db:rehearse:pr08": "bash ../../scripts/assurerail-pr08-db-rehearsal.sh",
    "db:rehearse:pr09": "bash ../../scripts/assurerail-pr09-db-rehearsal.sh",
    "db:rehearse:pr10": "bash ../../scripts/assurerail-pr10-db-rehearsal.sh",
    "db:rehearse:pr11": "bash ../../scripts/assurerail-pr11-db-rehearsal.sh",
    "db:rehearse:pr12": "bash ../../scripts/assurerail-pr12-db-rehearsal.sh",
    "db:rehearse:pr13": "bash ../../scripts/assurerail-pr13-db-rehearsal.sh",
    "db:rehearse:pr14": "bash ../../scripts/assurerail-pr14-db-rehearsal.sh",
    "db:rehearse:pr15": "bash ../../scripts/assurerail-pr15-db-rehearsal.sh",
    "db:rehearse:op01": "bash ../../scripts/assurerail-op01-db-rehearsal.sh",
    "seed:admin": "node dist/seed-admin.js",
    "test": "prisma generate && tsc && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@code/shared": "*",
    "@aws-sdk/client-s3": "^3.1052.0",
    "@google-cloud/recaptcha-enterprise": "^6.4.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "6.19.3",
    "@simplewebauthn/server": "^8.3.7",
    "class-transformer": "^0.5.1",
