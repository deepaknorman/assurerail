    "dotenv": "^16.4.5",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.0.0",
    "otplib": "^13.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "prisma": "6.19.3",
    "typescript": "^5.6.0"
  }
}
