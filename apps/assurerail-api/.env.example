# AssureRail venue (apps/assurerail-api) — its OWN env, separate from AssureLocker. No secrets here.

# The venue's OWN ring-fenced database — separate from AssureLocker's control/data planes. In prod a
# SEPARATE Postgres instance; locally a separate database on the shared dev Postgres server.
#
# Connection pool: Prisma opens a pool per process. Default pool size = (num_physical_cpus * 2 + 1). Under
# many concurrent API instances / PgBouncer, cap it explicitly so total connections stay under Postgres
# max_connections — append `?connection_limit=N` (and `&pool_timeout=10`). On a single box with one API
# process, connection_limit=10 is a safe default; behind PgBouncer (transaction mode) set connection_limit=1
# and add `&pgbouncer=true`. See docs/design/AssureRail_Capacity_And_Load_Testing.md §9.
#   e.g. DATABASE_URL="postgresql://USER:PASS@localhost:5432/assurerail_venue?connection_limit=10&pool_timeout=10"
DATABASE_URL="postgresql://USER:PASS@localhost:5432/assurerail_venue"

# Ports: venue api :3006, venue web :3007 (own ports — not AssureLocker's 3000/3001, not plaza's 3002/3003).
PORT=3006

# Explicit operating/evidence mode. NODE_ENV is only a Node optimisation setting; it does not grant
# live capabilities. DEMO forbids all live adapters. REPLAY/SHADOW forbid live mutating adapters.
# CONTROLLED_LIVE/PRODUCTION require the persistent/authenticated runtime and every adapter live.
ASSURERAIL_OPERATING_MODE=DEMO # DEMO | REPLAY | SHADOW | SANDBOX | CONTROLLED_LIVE | PRODUCTION
ARAIL_DEMO_ENDPOINTS_ENABLED=true

# PR-01 neutral contracts are inert by default. `read_only` permits serialization/comparison only;
# there is deliberately no write, enforce or live value until persistence/ingress lands in later PRs.
ARAIL_NEUTRAL_TAXONOMY_V1=off # off | read_only

# PR-02 persistence paths. Neutral intake has no public writer yet; `shadow` is reserved for the
# provider-neutral adapter in PR-05. Relay starts in legacy compatibility mode. `shadow` materialises
# durable delivery jobs but suppresses network egress; `durable` enables the retrying worker and is
# mandatory for CONTROLLED_LIVE/PRODUCTION. REPLAY/SHADOW forbid `durable` webhook egress.
ARAIL_NEUTRAL_INGRESS_V1=off # off | shadow | on
ARAIL_TRANSACTION_CASE_V1=off # off | shadow | on
ARAIL_EXTERNAL_ACTION_SAGA_V1=off # off | shadow | required; PR-09 remains observe-only
ARAIL_DA_REPLAY_V1=off # off | allow_list; requires saga=required and an approved per-case authorisation
ARAIL_PTC_REPLAY_V1=off # off | allow_list; historic replay evidence is never a live permission
ARAIL_DURABLE_RELAY_MODE=legacy # legacy | shadow | durable
ARAIL_PARTICIPANT_ADMISSION_V1=off # off | shadow | enforce
ARAIL_ROUTE_ENTITLEMENT_ENFORCE=off # off | compare | enforce
ARAIL_ROOM_READ_SOURCE=legacy # legacy | compare | rail
ARAIL_ROOM_WRITE_SOURCE=legacy # legacy | rail
ARAIL_COMPLETION_ACK_V1=off # off | shadow | on
ARAIL_LEGACY_ROOM_PROXY_V1=off # off | shadow

# PR-13 through PR-20 capabilities are explicit and fail closed. Shadow values are accepted only
# with their runtime dependencies in REPLAY/SHADOW; they are not controlled-live permissions.
# Tokenised DA is the sole flag with a future `live` value, which still requires a signed PR-12
# activation manifest and an exact capability registered in this build. The registry is empty until
# the corresponding real legal, connector, custody, participant and operating evidence is accepted.
ARAIL_TOKENISED_DA_V1=off # off | allow_list | live
ARAIL_TOKENISED_PTC_V1=off # off | shadow
ARAIL_PRIMARY_COMMERCIAL_V1=off # off | shadow
ARAIL_CONVENTIONAL_SECONDARY_V1=off # off | shadow
ARAIL_VENUE_CONDUCT_V1=off # off | shadow
ARAIL_DEVELOPER_PORTAL_V1=off # off | shadow
ARAIL_CUSTOMER_OPERATIONS_V1=off # off | shadow
ARAIL_HOSTED_ALPHA_V1=off # off | shadow; institution-scoped task/status productisation
ARAIL_INSTITUTIONAL_PRODUCT_V1=off # off | shadow; governed institutional access productisation
ARAIL_DA_PRODUCT_V1=off # off | shadow; conventional DA end-to-end product journey
ARAIL_PTC_PRODUCT_V1=off # off | shadow; conventional PTC end-to-end product journey
ARAIL_LIFECYCLE_PRODUCT_V1=off # off | shadow; post-completion lifecycle observation and reconciliation
ARAIL_PRIMARY_VENUE_PRODUCT_V1=off # off | shadow; usable named-audience primary venue and case handoff
ARAIL_SECONDARY_PRODUCT_V1=off # off | shadow; conventional DA/PTC secondary journey, exports and append-only repair
ARAIL_TOKENISED_PRODUCT_V1=off # off | shadow; unified tokenised-route product layer, never token authority
ARAIL_ENTERPRISE_INTEGRATION_V1=off # off | shadow; governed enterprise connector profiles, never provider certification or dispatch
ARAIL_PRODUCTION_SCALE_V1=off # off | shadow; internal readiness assessment command centre, never activation evidence
ARAIL_INTERNAL_RBAC_V1=off # off | shadow | enforce
ARAIL_WEBHOOK_MAX_ATTEMPTS=8
ARAIL_WEBHOOK_RETRY_BASE_MS=1000

# PR-05 neutral evidence object storage. Uploads are streamed to bounded private scratch space,
# content-sniffed and scanned by clamd before encrypted object storage. An absent/unreachable scanner
# produces QUARANTINED evidence and never AVAILABLE evidence. Never reuse AssureLocker buckets/keys.
ARAIL_OBJECT_STORE_ENDPOINT=""
ARAIL_OBJECT_STORE_REGION=ap-south-1
ARAIL_OBJECT_STORE_BUCKET=""
ARAIL_OBJECT_STORE_KMS_KEY_ID=""
ARAIL_OBJECT_STORE_FORCE_PATH_STYLE=false
# Local development only; controlled environments must use TLS.
ARAIL_OBJECT_STORE_ALLOW_HTTP=false
ARAIL_OBJECT_STORE_ACCESS_KEY=""
ARAIL_OBJECT_STORE_SECRET_KEY=""
ARAIL_CLAMAV_HOST=""
ARAIL_CLAMAV_PORT=3310
ARAIL_CLAMAV_TIMEOUT_MS=15000

# Webhook HMAC secrets are written to HashiCorp Vault KV-v2 and only the opaque reference is stored in
# Rail Postgres. AppRole is mandatory for CONTROLLED_LIVE/PRODUCTION; a static token is a
# dev/legacy fallback only. Never commit values.
VAULT_ADDR=""
VAULT_APPROLE_ROLE_ID=""
VAULT_APPROLE_SECRET_ID=""
VAULT_TOKEN=""
ARAIL_WEBHOOK_VAULT_MOUNT=secret
ARAIL_WEBHOOK_VAULT_PREFIX=assurerail/webhooks

# Adapters — all DEMO by default (deterministic, no external calls). Flip to `live` only when the
# corresponding real integration is provisioned (fail-closed if creds are absent).
TAPE_SOURCE=demo            # demo | live  — where the AssurePool tape is fetched from
HTS_ADAPTER=demo            # demo | live  — Hedera Token Service (mint) via plaza
HCS_ANCHOR=demo             # demo | live  — surveillance/event anchoring via plaza HCS
SETTLEMENT_ADAPTER=demo     # demo | live  — DvP settlement (e₹ first)
DIGIKYC_GATE=demo           # demo | live  — provider-backed identity evidence gate
SETTLEMENT_TOKEN=eRupee     # settlement instrument is a PARAMETER

# AssureLocker (the TSP) — the venue calls these at runtime. Scoped credential: the venue is entitled
# to ITS tapes only, never the cross-lender view (CoI barrier at the API).
ASSURELOCKER_API_URL="http://localhost:3000"
ASSURELOCKER_API_KEY=""

# DigiKYC gate (POST /v1/internal/digikyc-status). Box-only shared secret sent in the x-digikyc-status-secret
# header; MUST match DIGIKYC_STATUS_SERVICE_SECRET in apps/api. Required (with DIGIKYC_GATE=live +
# ASSURELOCKER_API_KEY) to enable the LIVE gate; if unset the LIVE gate fails closed. Never commit a real value.
DIGIKYC_STATUS_SERVICE_SECRET=""

# Seed a couple of demo pools on first boot if the DB is empty. Set false to disable.
SEED_ON_BOOT=true

# ── Auth (P2) — AssureRail's OWN Firebase project + reCAPTCHA Enterprise ──
# Public web config (safe): the front-end initialises Firebase with these.
FIREBASE_WEB_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_APP_ID=""
# reCAPTCHA Enterprise SITE key (public).
RECAPTCHA_SITE_KEY=""
# SECRETS (never commit; box env only): admin SDK JSON (base64) + reCAPTCHA secret (legacy verify fallback).
FIREBASE_ADMIN_CONFIG=""
RECAPTCHA_SECRET_KEY=""
