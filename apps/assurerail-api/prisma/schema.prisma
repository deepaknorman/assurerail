  expiresAt              DateTime
  status                 String   @default("PROPOSED") // PROPOSED | APPROVED | REJECTED | REVOKED | EXPIRED
  proposalDigest         String   @unique
  proposedByUserId       String
  proposalStepUpId       String
  reviewedByUserId       String?
  reviewStepUpId         String?
  reviewReason           String?
  reviewedAt             DateTime?
