  @@index([capacityBudgetId, state, observedAt])
  @@index([state, observedAt])
}

// ─────────────────────────────── account security (passkey + MFA) ───────────────────────────────
/// WebAuthn passkey credential (venue-own; hardware-backed sign-in). Owner is the Firebase uid.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  firebaseUid  String
  credentialId String    @unique // base64url
  publicKey    Bytes
  counter      BigInt    @default(0)
  deviceType   String?
  backedUp     Boolean   @default(false)
  transports   String[]  @default([])
  name         String? // user label
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([firebaseUid])
}

/// Short-lived WebAuthn challenge (registration/authentication). No FK (anon login challenges allowed).
model WebAuthnChallenge {
  id          String   @id @default(cuid())
  firebaseUid String // owner ("anon" for discoverable login)
  challenge   String   @unique
  type        String // registration | authentication
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([firebaseUid])
}

/// MFA enrollment — TOTP (authenticator app) primary. One row per (uid, method).
model MfaEnrollment {
  id          String    @id @default(cuid())
  firebaseUid String
  method      String // TOTP
  secret      String? // TOTP shared secret (base32)
  verified    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  verifiedAt  DateTime?

  @@unique([firebaseUid, method])
  @@index([firebaseUid])
}

// ─────────────────────────────── agentic ops (Crawl) ───────────────────────────────
/// A detected integrity/health break — the ops blackboard, deduped by fingerprint while OPEN. Populated
/// by the deterministic IntegrityEngine + LivenessSentinel; the read-only foundation of agentic ops.
model OpsFinding {
  id          String    @id @default(cuid())
  source      String // integrity | sentinel
  checkKey    String
  fingerprint String    @unique // sha256(checkKey|scopeRef) — one open finding per (check, subject)
  severity    String // INFO | WARN | CRITICAL
  status      String    @default("OPEN") // OPEN | RESOLVED
  scopeType   String // NOTE | GLOBAL | LEDGER | AUDIT | BILLING
  scopeRef    String?
  summary     String
  observed    Json?
  expected    Json?
  seenCount   Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status])
  @@index([checkKey])
}

/// Out-of-band ops control plane (singleton): kill-switch + autonomy mode + sweep/heartbeat markers.
model OpsControl {
  id               String    @id @default("singleton")
  agentMode        String    @default("observe") // observe | suggest | act
  killSwitch       Boolean   @default(false)
  lastSweepAt      DateTime?
  lastFindingCount Int       @default(0)
  updatedAt        DateTime  @updatedAt
}
