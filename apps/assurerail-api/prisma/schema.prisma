// AssureRail's OWN database — ring-fenced from AssureLocker (segregation primitive). Holds only the
// venue's records: no borrower PII / T2 ever lands here (only tape T0 commitments + T1 aggregates),
// plus the venue's own users/sessions/roles. Its client is generated to a NAMED output so it can
// never collide with AssureLocker's control/data clients.
generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/assurerail-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── venue identity & access ───────────────────────────────
// The venue's OWN user records. Identity is bound through a provider adapter (AssureLocker DigiKYC
// is the first adapter) and stores only a provider subject reference. Binding never grants admission.
model VenueUser {
  id          String  @id
  firebaseUid String? @unique // set on first Firebase (AssureRail project) login
  did         String? // legacy provider-subject alias retained for compatibility; a reference, never PII
  email       String  @unique
  displayName String?
  role        String  @default("INVESTOR") // function role: ISSUER | DESK | INVESTOR | TRUSTEE | REGULATOR
  isAdmin     Boolean @default(false) // platform admin (true iff platformRole set) — kept for the guard bypass

  // Platform tier — our own staff (mirrors plaza SUPER_ADMIN/ADMIN). Null for non-platform users.
  platformRole String? // SUPERADMIN | ADMIN
  // Entity tier — a lender/issuer org assigns roles to its own staff (mirrors AssureLocker membership).
  entityDid    String? // the org this user acts for (their entity/institution DID)
  entityRole   String? // ORGADMIN | MANAGER | OPERATOR

  allowlisted        Boolean   @default(false) // KYC allow-list gate (real onboarding is Trigger-1)
  status             String    @default("PENDING") // PENDING | ACTIVE | SUSPENDED
  identityProvider   String?
  identitySubject    String?
  identityVerifiedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions               VenueSession[]
  institutionMemberships InstitutionMember[]
  stepUpEvidence         StepUpEvidence[]
  internalRoleAssignments InternalRoleAssignment[]
  privilegedAccessRequests PrivilegedAccessRequest[]
  internalAccessEvents     InternalAccessEvent[]

  @@index([did])
  @@index([entityDid])
}

/// A venue session (passkey / Firebase login), kept for audit + revocation.
model VenueSession {
  id                  String           @id
  userId              String
  user                VenueUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeInstitutionId String?
  credentialAssurance String?
  revokedAt           DateTime?
  revocationReason    String?
  securityContext     Json?
  createdAt           DateTime         @default(now())
  lastSeenAt          DateTime         @default(now())
  expiresAt           DateTime?
  userAgent           String?
  ip                  String?
  stepUpEvidence      StepUpEvidence[]

  @@index([userId])
  @@index([activeInstitutionId])
  @@index([revokedAt])
}

// ───────────────────── internal staff control plane (OP-01) ─────────────────────
// These assignments are intentionally not InstitutionMember/Mandate/Appointment records. A Rail
// employee's internal job function cannot become customer or transaction authority by sharing a user ID.
model InternalRoleAssignment {
  id                  String    @id
  userId              String
  user                VenueUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  role                String    // SUPERADMIN | SYSADMIN | SECURITY_ADMIN | ORGADMIN | MANAGER | …
  scopeType           String    // GLOBAL | OPERATING_UNIT | ENVIRONMENT | CASE | SUPPORT_TICKET
  scopeRef            String?
  scopeKey            String    // canonical `${scopeType}:${scopeRef ?? "*"}` — avoids NULL uniqueness gaps
  status              String    @default("PROPOSED") // PROPOSED | ACTIVE | SUSPENDED | EXPIRED | REVOKED | SUPERSEDED
  version             Int       @default(1)
  reason              String
  evidenceRef         String?
  proposalDigest      String    @unique
  proposedByUserId    String
  proposalStepUpId    String?
  approvedByUserId    String?
  approvalStepUpId    String?
  approvalReason      String?
  effectiveAt         DateTime?
  expiresAt           DateTime?
  suspendedAt         DateTime?
  revokedAt           DateTime?
  supersedesId        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  accessEvents        InternalAccessEvent[]

  @@unique([userId, role, scopeKey, version])
  @@index([userId, status, expiresAt])
  @@index([role, status, scopeType, scopeRef])
  @@index([proposedByUserId, createdAt])
}

// A bounded support/incident/recovery exception. It adds one requested permission at one scope for a
// short period; it is not a second, invisible administrator account and does not carry case authority.
model PrivilegedAccessRequest {
  id                  String    @id
  userId              String
  user                VenueUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  requestedPermission String
  scopeType           String
  scopeRef            String?
  scopeKey            String
  status              String    @default("REQUESTED") // REQUESTED | APPROVED | ACTIVE | DENIED | EXPIRED | REVOKED | CLOSED
  reason              String
  ticketRef           String
  riskClass           String
  requestedAt         DateTime  @default(now())
  startsAt            DateTime?
  expiresAt           DateTime?
  requestedByUserId   String
  requestStepUpId     String?
  approvedByUserId    String?
  approvalStepUpId    String?
  approvalReason      String?
  deniedByUserId      String?
  deniedAt            DateTime?
  revokedByUserId     String?
  revokedAt           DateTime?
  closedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  accessEvents        InternalAccessEvent[]

  @@index([userId, status, expiresAt])
  @@index([status, scopeType, scopeRef])
  @@index([ticketRef])
}

// Append-only receipt for role/elevation decisions and every privileged access use. No arbitrary JSON
// overwrite is permitted; event payload is canonical/digested by the service layer.
model InternalAccessEvent {
  id                       String                  @id
  userId                   String
  user                     VenueUser               @relation(fields: [userId], references: [id], onDelete: Restrict)
  internalRoleAssignmentId String?
  internalRoleAssignment   InternalRoleAssignment? @relation(fields: [internalRoleAssignmentId], references: [id], onDelete: Restrict)
  privilegedAccessRequestId String?
  privilegedAccessRequest   PrivilegedAccessRequest? @relation(fields: [privilegedAccessRequestId], references: [id], onDelete: Restrict)
  eventType                String
  permission               String?
  scopeType                String?
  scopeRef                 String?
  requestId                String?
  reason                   String?
  payloadDigest            String
  occurredAt               DateTime                @default(now())

  @@index([userId, occurredAt])
  @@index([internalRoleAssignmentId, occurredAt])
  @@index([privilegedAccessRequestId, occurredAt])
  @@index([eventType, occurredAt])
}

// ───────────────────── institution, admission and scoped authority (PR-03) ─────────────────────
// These are Rail-local relationship/authority records. Provider identity evidence is retained as a
// signed/digested snapshot; it does not make the provider a runtime authority over Rail membership.

model Institution {
  id               String    @id
  legalName        String
  institutionKind  String
  jurisdiction     String
  legalIdentifiers Json
  legacyEntityRef  String?   @unique
  status           String    @default("APPLICANT") // APPLICANT | ACTIVE | SUSPENDED | REVOKED | LEGACY_REFERENCE_ONLY
  applicantUserId  String
  suspensionReason String?
  suspendedAt      DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  admission               ParticipantAdmission?
  evidenceSnapshots       InstitutionEvidenceSnapshot[]
  members                 InstitutionMember[]
  mandates                AuthorityMandate[]
  appointments            Appointment[]
  routeEntitlements       RouteEntitlement[]
  servicePrincipals       InstitutionServicePrincipal[]
  identityConnections     InstitutionIdentityConnection[]
  accessReviews           InstitutionAccessReview[]
  exitPlans               InstitutionExitPlan[]
  changeProposals         InstitutionChangeProposal[]
  connectorRegistrations  ConnectorRegistration[]
  evidenceObjects         EvidenceObject[]
  documentFamilies        RailDocumentFamily[]
  ownedTransactionCases   TransactionCase[]             @relation("CaseOwnerInstitution")
  caseParties             CaseParty[]
  caseFunctionAssignments CaseFunctionAssignment[]      @relation("FunctionPerformerInstitution")
  caseRoomGrants          RoomGrant[]                   @relation("RoomGrantInstitution")
  connectorSubjectMaps    ConnectorSubjectMapping[]     @relation("ConnectorSubjectInstitution")
  authoritativeRecords    AuthoritativeRecordDeclaration[] @relation("AuthoritativeRecordkeeperInstitution")
  reconciliationBreaks    ReconciliationBreak[]         @relation("ReconciliationBreakOwnerInstitution")
  tokenReconciliationBreaks TokenReconciliationBreak[]
  ownedCommercialOpportunities CommercialOpportunity[] @relation("CommercialOpportunityOwnerInstitution")
  commercialAudienceGrants    CommercialAudienceGrant[]
  commercialInterests         CommercialInterestIndication[]
  commercialRfqs              CommercialRfq[]           @relation("CommercialRfqRequesterInstitution")
  ownedNegotiationThreads     CommercialNegotiationThread[] @relation("CommercialThreadOwnerInstitution")
  counterpartyThreads         CommercialNegotiationThread[] @relation("CommercialThreadCounterpartyInstitution")
  commercialMessages          CommercialNegotiationMessage[]
  commercialAllocations       CommercialAllocation[]
  secondaryTransfersAsSeller  SecondaryTransfer[] @relation("SecondaryTransferSellerInstitution")
  secondaryTransfersAsBuyer   SecondaryTransfer[] @relation("SecondaryTransferBuyerInstitution")
  secondaryTransfersAsTrustee SecondaryTransfer[] @relation("SecondaryTransferTrusteeInstitution")
  secondaryTransfersAsRecordkeeper SecondaryTransfer[] @relation("SecondaryTransferRecordkeeperInstitution")
  developerClients         DeveloperClientRegistration[]
  developerConformanceRuns DeveloperConformanceRun[]
  integrationExitExports   IntegrationExitExport[]
  customerContracts        CustomerContract[]
  customerUsageEvents      CustomerUsageEvent[]
  implementationCohorts    CustomerImplementationCohort[]
  customerServiceRequests  CustomerServiceRequest[]
  customerOperationalReviews CustomerOperationalReview[]
  customerDataExitExports  CustomerDataExitExport[]
  secondaryTransferEvidence   SecondaryTransferEvidence[]
  secondaryTransferBreaks     SecondaryTransferBreak[] @relation("SecondaryTransferBreakOwnerInstitution")
  secondaryTransferRepairs    SecondaryTransferRepair[] @relation("SecondaryTransferRepairProviderInstitution")
  tokenCustodyAssignments     TokenConnectorBinding[] @relation("TokenCustodyInstitution")
  ptcTokenTrusteeRepresentations PtcTokenRepresentation[] @relation("PtcTokenTrusteeInstitution")
  ptcTokenRecordkeeperRepresentations PtcTokenRepresentation[] @relation("PtcTokenRecordkeeperInstitution")
  ptcTokenAssuranceRepresentations PtcTokenRepresentation[] @relation("PtcTokenAssuranceInstitution")
  ptcTokenEvidenceResponsibilities PtcTokenEvidenceGate[] @relation("PtcTokenGateAccountableInstitution")
  lifecycleObligations RailLifecycleObligation[] @relation("LifecycleObligationOwnerInstitution")
  lifecycleBreaks RailLifecycleBreak[] @relation("LifecycleBreakOwnerInstitution")
  commercialHandoffsOwned CommercialCaseHandoff[] @relation("CommercialHandoffOwnerInstitution")
  commercialHandoffsReceived CommercialCaseHandoff[] @relation("CommercialHandoffCounterpartyInstitution")

  @@index([status])
  @@index([applicantUserId])
}

model InstitutionEvidenceSnapshot {
  id                     String             @id
  institutionId          String
  institution            Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  providerReferenceId    String?
  providerReference      ProviderReference? @relation(fields: [providerReferenceId], references: [id], onDelete: Restrict)
  providerInstitutionRef String
  evidenceType           String
  schemaId               String
  schemaVersion          String
  payloadDigest          String
  signatureStatus        String
  result                 String // VERIFIED | PARTIALLY_VERIFIED | UNVERIFIED | FAILED | EXPIRED | REVIEW_REQUIRED
  verificationMethod     String
  independenceClass      String
  assertions             Json
  crossCheckExpected     Json
  crossCheckAchieved     Json
  qualifications         Json
  sourceAsOfAt           DateTime
  expiresAt              DateTime
  supersedesSnapshotId   String?
  storageRef             String?
  evidenceVersionId      String?            @unique
  evidenceVersion        EvidenceVersion?   @relation(fields: [evidenceVersionId], references: [id], onDelete: Restrict)
  createdByUserId        String
  createdAt              DateTime           @default(now())

  @@unique([institutionId, payloadDigest])
  @@index([institutionId, evidenceType, sourceAsOfAt])
  @@index([providerReferenceId])
  @@index([expiresAt])
}

model ParticipantAdmission {
  id                String                         @id
  institutionId     String                         @unique
  institution       Institution                    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  status            String                         @default("APPLIED") // APPLIED | UNDER_REVIEW | ADMITTED | SUSPENDED | REVOKED | REJECTED | EXPIRED | NOT_ADMITTED
  termsVersion      String
  rulebookVersion   String
  riskClass         String?
  applicationDigest String
  reviewDueAt       DateTime?
  effectiveAt       DateTime?
  expiresAt         DateTime?
  suspendedAt       DateTime?
  revokedAt         DateTime?
  decisionReason    String?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @default(now()) @updatedAt
  decisions         ParticipantAdmissionDecision[]

  @@index([status, createdAt])
  @@index([reviewDueAt])
}

model ParticipantAdmissionDecision {
  id                     String               @id
  participantAdmissionId String
  participantAdmission   ParticipantAdmission @relation(fields: [participantAdmissionId], references: [id], onDelete: Restrict)
  decisionType           String // ADMIT | REJECT | SUSPEND | REVOKE | RECERTIFY | REINSTATE
  fromAdmissionStatus    String
  status                 String               @default("PENDING") // PENDING | APPROVED | REJECTED | SUPERSEDED
  reason                 String
  evidenceSnapshotIds    Json
  proposedRiskClass      String?
  proposedExpiresAt      DateTime?
  proposedReviewDueAt    DateTime?
  proposalDigest         String
  proposedByUserId       String
  proposalStepUpId       String
  reviewedByUserId       String?
  reviewStepUpId         String?
  reviewNote             String?
  proposedAt             DateTime             @default(now())
  reviewedAt             DateTime?
  appliedAt              DateTime?

  @@index([participantAdmissionId, status])
  @@index([proposedByUserId])
}

model InstitutionMember {
  id                          String             @id
  institutionId               String
  institution                 Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  userId                      String
  user                        VenueUser          @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitedEmail                String
  membershipRole              String             @default("MEMBER") // APPLICANT | ADMIN | MEMBER | AUDITOR | INTEGRATION_OPERATOR | LEGACY_PROJECTED
  status                      String             @default("INVITED") // INVITED | PENDING_ADMISSION | ACTIVE | SUSPENDED | REVOKED | EXPIRED | LEGACY_PROJECTED
  invitedByUserId             String?
  invitationDigest            String?
  invitedAt                   DateTime           @default(now())
  acceptedAt                  DateTime?
  effectiveAt                 DateTime?
  expiresAt                   DateTime?
  suspendedAt                 DateTime?
  revokedAt                   DateTime?
  revocationReason            String?
  legacyEntityRole            String?
  bootstrapApprovedDecisionId String?
  recertificationDueAt        DateTime?
  lastUsedAt                  DateTime?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @default(now()) @updatedAt
  mandates                    AuthorityMandate[]

  @@unique([institutionId, userId])
  @@index([institutionId, status])
  @@index([userId, status])
  @@index([invitedEmail])
}

model AuthorityMandate {
  id                   String            @id
  institutionId        String
  institution          Institution       @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  memberId             String
  member               InstitutionMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  action               String
  scopeType            String
  scopeRef             String?
  scopeKey             String
  limits               Json
  conditions           Json
  delegationBasis      String
  authorityEvidenceRef String
  makerCheckerRequired Boolean           @default(true)
  status               String            @default("PROPOSED") // PROPOSED | ACTIVE | REJECTED | SUPERSEDED | SUSPENDED | REVOKED | EXPIRED
  version              Int               @default(1)
  supersedesMandateId  String?
  proposedByUserId     String
  proposalStepUpId     String
  approvedByUserId     String?
  approvalStepUpId     String?
  approvalReason       String?
  effectiveAt          DateTime?
  expiresAt            DateTime?
  suspendedAt          DateTime?
  revokedAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now()) @updatedAt

  @@unique([memberId, action, scopeType, scopeKey, version])
  @@index([institutionId, status])
  @@index([memberId, action, status])
  @@index([expiresAt])
}

model Appointment {
  id                     String      @id
  institutionId          String
  institution            Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  transactionCaseId      String?
  appointmentRole        String
  appointeeInstitutionId String?
  appointeeProviderRef   String?
  scope                  Json
  conflictDisclosure     Json
  status                 String      @default("PROPOSED") // PROPOSED | ACCEPTED | ACTIVE | DECLINED | SUSPENDED | REVOKED | EXPIRED
  proposedByUserId       String
  proposalStepUpId       String
  acceptedByUserId       String?
  acceptanceStepUpId     String?
  effectiveAt            DateTime?
  expiresAt              DateTime?
  suspendedAt            DateTime?
  revokedAt              DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @default(now()) @updatedAt

  @@index([institutionId, status])
  @@index([appointeeInstitutionId, status])
  @@index([transactionCaseId])
}

model RouteEntitlement {
  id                    String      @id
  institutionId         String
  institution           Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  transactionRoute      String
  representation        String
  assetClass            String
  lifecycleLeg          String
  materialFunction      String
  functionPerformer     String
  routePackRef          String
  permissionEvidenceRef String
  operatingModes        Json
  limits                Json
  conditions            Json
  status                String      @default("PROPOSED") // PROPOSED | ACTIVE | REJECTED | SUSPENDED | REVOKED | EXPIRED
  proposedByUserId      String
  proposalStepUpId      String
  approvedByUserId      String?
  approvalStepUpId      String?
  approvalReason        String?
  effectiveAt           DateTime?
  expiresAt             DateTime?
  suspendedAt           DateTime?
  revokedAt             DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @default(now()) @updatedAt

  @@index([institutionId, status])
  @@index([institutionId, transactionRoute, representation, materialFunction, status], map: "RouteEntitlement_route_function_status_idx")
  @@index([expiresAt])
}

model InstitutionServicePrincipal {
  id                 String      @id
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  clientId           String      @unique
  displayName        String      @default("Legacy service principal")
  credentialVaultRef String
  credentialFingerprint String?
  status             String      @default("PENDING") // PENDING | SHADOW_APPROVED | ACTIVE | SUSPENDED | REVOKED | EXPIRED
  allowedActions     Json
  proposedByUserId   String?
  proposalStepUpId   String?
  approvedByUserId   String?
  approvalStepUpId   String?
  approvalReason     String?
  lastUsedAt         DateTime?
  effectiveAt        DateTime?
  expiresAt          DateTime?
  suspendedAt        DateTime?
  revokedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt

  @@index([institutionId, status])
  @@index([expiresAt])
}

model InstitutionIdentityConnection {
  id                 String      @id
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  connectionKey      String
  protocol           String // SAML | OIDC
  displayName        String
  issuer             String
  audience           String
  metadataDigest     String
  emailDomains       Json
  status             String      @default("PROPOSED") // PROPOSED | SHADOW_APPROVED | REJECTED | SUSPENDED | REVOKED | EXPIRED
  proposedByUserId   String
  proposalStepUpId   String
  reviewedByUserId   String?
  reviewStepUpId     String?
  reviewReason       String?
  effectiveAt        DateTime?
  expiresAt          DateTime?
  suspendedAt        DateTime?
  revokedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt

  @@unique([institutionId, connectionKey])
  @@index([institutionId, status])
  @@index([expiresAt])
}

model InstitutionAccessReview {
  id                 String      @id
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  reviewRef          String
  scope              Json
  evidenceRefs       Json
  dueAt              DateTime
  status             String      @default("PROPOSED") // PROPOSED | APPROVED | REJECTED | SUPERSEDED
  conclusion         String?
  proposedByUserId   String
  proposalStepUpId   String
  reviewedByUserId   String?
  reviewStepUpId     String?
  reviewReason       String?
  reviewedAt         DateTime?
  createdAt          DateTime    @default(now())

  @@unique([institutionId, reviewRef])
  @@index([institutionId, status, dueAt])
}

model InstitutionExitPlan {
  id                   String      @id
  institutionId        String
  institution          Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  exitRef               String
  reason                String
  requestedEffectiveAt DateTime
  scope                 Json
  evidenceRefs          Json
  status                String      @default("PROPOSED") // PROPOSED | APPROVED | REJECTED | CANCELLED | COMPLETED
  proposedByUserId      String
  proposalStepUpId      String
  reviewedByUserId      String?
  reviewStepUpId        String?
  reviewReason          String?
  reviewedAt            DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @default(now()) @updatedAt

  @@unique([institutionId, exitRef])
  @@index([institutionId, status])
  @@index([requestedEffectiveAt])
}

model InstitutionChangeProposal {
  id               String      @id
  institutionId    String
  institution      Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  targetType       String // MEMBER | MANDATE | APPOINTMENT | ROUTE_ENTITLEMENT | SERVICE_PRINCIPAL | IDENTITY_CONNECTION
  targetId         String
  changeType       String // SUSPEND | REVOKE | REINSTATE
  fromStatus       String
  reason           String
  proposalPayload  Json
  proposalDigest   String
  status           String      @default("PENDING") // PENDING | APPROVED | REJECTED | SUPERSEDED
  proposedByUserId String
  proposalStepUpId String
  reviewedByUserId String?
  reviewStepUpId   String?
  reviewNote       String?
  proposedAt       DateTime    @default(now())
  reviewedAt       DateTime?
  appliedAt        DateTime?

  @@index([institutionId, status])
  @@index([targetType, targetId, status])
}

model StepUpEvidence {
  id               String       @id
  userId           String
  user             VenueUser    @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessionId        String
  session          VenueSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  firebaseUid      String
  institutionId    String?
  method           String
  purpose          String
  assuranceContext Json
  evidenceDigest   String       @unique
  issuedAt         DateTime     @default(now())
  expiresAt        DateTime
  consumedAt       DateTime?
  revokedAt        DateTime?

  @@index([userId, purpose, expiresAt])
  @@index([sessionId, expiresAt])
  @@index([institutionId, expiresAt])
  @@index([firebaseUid])
}

// ─────────────────────────────── venue records ───────────────────────────────
/// A minted AssurePool Note — provenance traces back to the AssureLocker tape via tapeHash/manifestHash.
model Note {
  id           String   @id
  poolId       String
  tapeHash     String // integrity link to the exact tape consumed
  manifestHash String
  tokenId      String // HTS token id (DEMO fake or real 0.0.x)
  serials      Json // minted serials
  t1Aggregates Json // structural/aggregate snapshot at mint (no PII)
  state        String   @default("ISSUED") // ISSUED | ACTIVE | REDEEMED
  createdAt    DateTime @default(now())

  // Closure / redemption (the mirror of mint): tokens burned, supply → 0, holdings zeroed.
  burnTxRef      String? // HTS burn tx ref
  closeAnchorRef String? // HCS anchor of the closure event
  closeReason    String? // maturity | clean_up_call | call | amortised | manual
  redeemedAt     DateTime?
  tokenRepresentation TokenRepresentation?

  @@index([poolId])
}

/// Allow-listed holder positions in a Note (KYC-gated allow-list; real onboarding is Trigger-1).
model NoteHolding {
  id        String   @id
  noteId    String
  holderDid String
  units     String // minor units held
  createdAt DateTime @default(now()) // stable acquisition order (listHoldings orders by this, not the mutable updatedAt)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([noteId, holderDid])
  @@index([noteId])
}

/// Append-only mint audit: what tape was consumed, the k-anon result, lock ref, HTS tx, actor.
model MintLog {
  id          String   @id
  poolId      String
  tapeHash    String
  kAnonPassed Boolean
  kAnonDetail Json
  lockRef     String
  htsTxRef    String? // HTS tx / token ref (blank on a blocked attempt)
  actor       String // system:tokenco
  createdAt   DateTime @default(now())

  @@index([poolId])
}

/// Per-cycle surveillance mirror pulled from AssureLocker, anchored via plaza HCS (2c).
model SurveillanceMirror {
  id        String   @id
  noteId    String
  period    String // YYYY-MM
  verdict   Json
  anchorRef String? // topicId#sequenceNumber (HCS)
  createdAt DateTime @default(now())

  @@unique([noteId, period])
  @@index([noteId])
}

/// Atomic delivery-vs-payment record — asset units (issuer→buyer) settled against the settlement token.
model Dvp {
  id              String   @id
  noteId          String
  sellerDid       String
  buyerDid        String
  units           String // minor
  settlementMinor String
  settlementToken String
  settlementRef   String   @unique // one settlement ref per DvP (the DEMO adapter now emits a unique ref)
  anchorRef       String // topicId#sequenceNumber (HCS)
  actor           String
  createdAt       DateTime @default(now())

  @@index([noteId])
}

/// Regulator break-glass ACCESS event (the venue anchors who-saw-what-when; T2/PII stays at AssureLocker).
model BreakGlass {
  id            String   @id
  noteId        String
  regulatorDid  String
  lawfulPurpose String
  anchorRef     String // topicId#sequenceNumber (HCS)
  createdAt     DateTime @default(now())

  @@index([noteId])
}

/// Uploaded document (closing docs / pool files). Bytes held inline (DEMO); MinIO/S3 at scale.
model Document {
  id                       String   @id
  filename                 String
  contentType              String
  size                     Int
  noteId                   String?
  uploadedBy               String?
  data                     Bytes? // legacy inline bytes; neutral documents retain only object-storage references
  neutralDocumentVersionId String?  @unique
  createdAt                DateTime @default(now())

  @@index([noteId])
}

/// A pool submitted via the data-feed ingress endpoint (a lender/aggregator pushing a pool to mint).
model IngestedPool {
  id                        String   @id
  poolId                    String   @unique
  source                    String
  spec                      Json
  minted                    Boolean  @default(false)
  neutralIntakeSubmissionId String?  @unique
  createdAt                 DateTime @default(now())
}

/// Append-only usage meter for billing (one row per billable lifecycle event).
model BillingEvent {
  id            String   @id
  type          String // mint | dvp | close
  noteId        String?
  unitsMinor    String?
  actor         String?
  sourceEventId String?  @unique // the EventLog row this meter derives from — one bill per event (idempotent)
  createdAt     DateTime @default(now())

  @@index([type])
}

/// Webhook subscription (partner egress). `events` is a JSON array of event names or ["*"].
model WebhookSubscription {
  id                        String    @id
  institutionId             String?
  url                       String
  secret                    String? // legacy only; PR-02 clears/disables old plaintext rows and never writes this field
  secretVaultRef            String?
  events                    Json
  active                    Boolean   @default(false)
  endpointStatus            String    @default("PENDING_VERIFICATION") // PENDING_VERIFICATION | VERIFIED | DISABLED | REVOKED
  verificationChallengeHash String?
  verificationExpiresAt     DateTime?
  verifiedAt                DateTime?
  disabledReason            String?
  revokedAt                 DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @default(now()) @updatedAt

  @@index([institutionId])
  @@index([active, endpointStatus])
}

/// Durable webhook delivery job/attempt record. One stable delivery ID is reused across retries so
/// receivers can deduplicate an ambiguous acknowledgement after a worker crash.
model WebhookDelivery {
  id              String         @id
  subscriptionId  String
  outboxMessageId String?
  outboxMessage   OutboxMessage? @relation(fields: [outboxMessageId], references: [id], onDelete: Restrict)
  event           String
  payloadDigest   String?
  state           String         @default("PENDING") // PENDING | IN_FLIGHT | RETRY | DELIVERED | DEAD_LETTER | BLOCKED | SHADOW_SUPPRESSED
  attempt         Int            @default(0)
  statusCode      Int?
  ok              Boolean        @default(false)
  nextAttemptAt   DateTime       @default(now())
  lockedAt        DateTime?
  lockOwner       String?
  errorCode       String?
  errorMessage    String?
  responseDigest  String?
  deliveredAt     DateTime?
  terminalAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  @@unique([outboxMessageId, subscriptionId])
  @@index([subscriptionId])
  @@index([state, nextAttemptAt])
  @@index([outboxMessageId])
}

/// Append-only event log (lifecycle events) — powers the support/ops dashboard.
model EventLog {
  id                String         @id
  event             String
  payload           Json
  schemaVersion     String?
  aggregateId       String?
  aggregateVersion  Int?
  institutionId     String?
  transactionCaseId String?
  idempotencyKey    String?        @unique
  correlationId     String?
  causationId       String?
  createdAt         DateTime       @default(now())
  outboxMessage     OutboxMessage?

  @@index([event])
  @@index([createdAt])
  @@index([institutionId, createdAt])
  @@index([transactionCaseId, createdAt])
}

// ─────────────────────── neutral persistence / integration foundation ───────────────────────
// These additive records deliberately carry nullable institution/case ownership until PR-03/PR-06
// create the authoritative Institution and TransactionCase tables. They do not foreign-key into the
// AssureLocker database or grant participant/route authority.

model ProviderReference {
  id                     String                        @id
  providerKey            String
  providerType           String
  displayName            String?
  status                 String                        @default("ACTIVE") // ACTIVE | SUSPENDED | RETIRED
  institutionId          String?
  transactionCaseId      String?
  metadata               Json?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @default(now()) @updatedAt
  sourceReferences       SourceReference[]
  intakeSubmissions      IntakeSubmission[]
  inboxMessages          InboxMessage[]
  instructions           ExternalInstruction[]
  acknowledgements       ExternalAcknowledgement[]
  institutionEvidence    InstitutionEvidenceSnapshot[]
  connectorRegistrations ConnectorRegistration[]
  evidenceVersions       EvidenceVersion[]
  sourceCompletions      SourceCompletion[]

  @@unique([providerType, providerKey])
  @@index([institutionId])
  @@index([transactionCaseId])
}

model SourceReference {
  id                  String             @id
  providerReferenceId String
  providerReference   ProviderReference  @relation(fields: [providerReferenceId], references: [id], onDelete: Restrict)
  sourceSystem        String
  sourceObjectType    String
  sourceObjectId      String
  sourceVersion       String
  schemaId            String
  schemaVersion       String
  payloadDigest       String
  authoritativeStatus String             @default("UNDECLARED")
  institutionId       String?
  transactionCaseId   String?
  metadata            Json?
  createdAt           DateTime           @default(now())
  intakeSubmissions   IntakeSubmission[]
  caseRooms           CaseRoom[]
  sourceCompletions   SourceCompletion[]
  authoritativeRecords AuthoritativeRecordDeclaration[]

  @@unique([providerReferenceId, sourceSystem, sourceObjectType, sourceObjectId, sourceVersion], map: "SourceReference_source_identity_key")
  @@index([payloadDigest])
  @@index([institutionId])
  @@index([transactionCaseId])
}

model IntakeSubmission {
  id                  String            @id
  providerReferenceId String
  providerReference   ProviderReference @relation(fields: [providerReferenceId], references: [id], onDelete: Restrict)
  sourceReferenceId   String?
  sourceReference     SourceReference?  @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict)
  institutionId       String?
  transactionCaseId   String?
  idempotencyKey      String
  carrier             String
  schemaId            String
  schemaVersion       String
  payloadDigest       String
  signatureDigest     String?
  signatureStatus     String
  storageRef          String?
  payload             Json?
  validationStatus    String            @default("RECEIVED") // RECEIVED | VALID | INVALID | CONFLICT | QUARANTINED
  validationDetail    Json?
  receivedAt          DateTime          @default(now())
  createdAt           DateTime          @default(now())
  receipt             IntakeReceipt?
  evidenceVersion     EvidenceVersion?

  @@unique([providerReferenceId, idempotencyKey])
  @@index([sourceReferenceId])
  @@index([payloadDigest])
  @@index([institutionId, receivedAt])
  @@index([transactionCaseId, receivedAt])
}

// ───────────────── provider-neutral evidence, documents and certified connectors (PR-05) ───────────────

model ConnectorRegistration {
  id                  String                    @id
  institutionId       String
  institution         Institution               @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  providerReferenceId String?
  providerReference   ProviderReference?        @relation(fields: [providerReferenceId], references: [id], onDelete: Restrict)
  connectorKey        String
  connectorType       String
  displayName         String
  transport           String // FILE | API
  endpoint            String?
  schemaProfiles      Json
  credentialVaultRef  String?
  status              String                    @default("PENDING_CERTIFICATION") // PENDING_CERTIFICATION | CERTIFIED_SHADOW | SUSPENDED | REVOKED
  createdByUserId     String
  suspendedAt         DateTime?
  revokedAt           DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @default(now()) @updatedAt
  certifications      ConnectorCertification[]
  subjectMappings     ConnectorSubjectMapping[]
  sourceCompletions   SourceCompletion[]
  tokenConnectorBindings TokenConnectorBinding[]
  developerConformanceRuns DeveloperConformanceRun[]

  @@unique([institutionId, connectorKey])
  @@index([institutionId, status])
  @@index([providerReferenceId])
}

// ───────────────── institution integration/developer workspace (PR-19, shadow only) ────────────

model DeveloperClientRegistration {
  id                       String      @id
  institutionId            String
  institution              Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  clientKey                String
  displayName              String
  allowedActions           Json
  status                   String      @default("SHADOW_ONLY") // SHADOW_ONLY | SUSPENDED | REVOKED
  currentCredentialVersion Int         @default(0)
  createdByUserId          String
  createdByMandateId       String
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @default(now()) @updatedAt
  credentials              DeveloperCredentialVersion[]

  @@unique([institutionId, clientKey], map: "DeveloperClientRegistration_institution_key")
  @@index([institutionId, status])
}

model DeveloperCredentialVersion {
  id                    String                      @id
  developerClientId     String
  developerClient       DeveloperClientRegistration @relation(fields: [developerClientId], references: [id], onDelete: Restrict)
  version               Int
  credentialVaultRef    String
  credentialFingerprint String
  status                String                      @default("ACTIVE_SHADOW") // ACTIVE_SHADOW | SUPERSEDED | REVOKED | EXPIRED
  reason                String
  createdByUserId       String
  createdByMandateId    String
  stepUpEvidenceId      String
  effectiveAt           DateTime
  expiresAt             DateTime
  supersededAt          DateTime?
  revokedAt             DateTime?
  createdAt             DateTime                    @default(now())

  @@unique([developerClientId, version], map: "DeveloperCredentialVersion_client_version")
  @@unique([developerClientId, credentialFingerprint], map: "DeveloperCredentialVersion_client_fingerprint")
  @@index([status, expiresAt])
}

model DeveloperConformanceRun {
  id                      String                @id
  institutionId           String
  institution             Institution           @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  connectorRegistrationId String
  connectorRegistration   ConnectorRegistration @relation(fields: [connectorRegistrationId], references: [id], onDelete: Restrict)
  fixtureSetVersion       String
  schemaProfileRef        String
  result                  String // PASSED_SOFTWARE | FAILED_SOFTWARE | REVIEW_REQUIRED
  assertions              Json
  inputDigest             String
  resultDigest            String
  sandboxNonEvidence      Boolean               @default(true)
  createdByUserId         String
  createdByMandateId      String
  stepUpEvidenceId        String
  createdAt               DateTime              @default(now())

  @@index([institutionId, connectorRegistrationId, createdAt], map: "DeveloperConformanceRun_scope_time")
}

model IntegrationExitExport {
  id                 String      @id
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  exportVersion      String
  scope              Json
  recordCounts       Json
  manifestDigest     String
  requestedByUserId  String
  requestedByMandateId String
  stepUpEvidenceId   String
  createdAt          DateTime    @default(now())

  @@index([institutionId, createdAt])
}

// ───────────────── customer operations and commercial administration (PR-20, shadow) ──────────

model CustomerContract {
  id                         String      @id
  institutionId              String
  institution                Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  contractRef                String
  version                    Int         @default(1)
  status                     String      @default("PROPOSED") // PROPOSED | APPROVED_PENDING_CUSTOMER | ACTIVE_SHADOW | SUSPENDED | TERMINATED | EXPIRED | REJECTED
  currency                   String
  currencyScale              Int
  termsDigest                String
  termsEvidenceRef           String
  proposedByUserId           String
  proposalStepUpId           String
  reviewedByUserId           String?
  reviewStepUpId             String?
  reviewReason               String?
  reviewedAt                 DateTime?
  participantAcceptedByUserId String?
  participantMandateId       String?
  participantStepUpId        String?
  participantAcceptedAt      DateTime?
  effectiveAt                DateTime
  expiresAt                  DateTime
  renewalReviewAt            DateTime
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @default(now()) @updatedAt
  changes                    CustomerContractChange[]
  rateCards                  CustomerRateCard[]
  usageEvents                CustomerUsageEvent[]
  invoiceStatements          CustomerInvoiceStatement[]
  creditCorrections          CustomerCreditCorrection[]
  cohorts                    CustomerImplementationCohort[]

  @@unique([institutionId, contractRef, version], map: "CustomerContract_institution_ref_version")
  @@index([institutionId, status, effectiveAt, expiresAt], map: "CustomerContract_scope_status_term")
}

model CustomerContractChange {
  id                 String           @id
  customerContractId String
  customerContract   CustomerContract @relation(fields: [customerContractId], references: [id], onDelete: Restrict)
  changeType         String // RENEW | SUSPEND | TERMINATE | REINSTATE
  fromStatus         String
  proposedValues     Json
  reason             String
  evidenceRef        String
  proposalDigest     String
  status             String           @default("PROPOSED")
  proposedByUserId   String
  proposalStepUpId   String
  reviewedByUserId   String?
  reviewStepUpId     String?
  reviewReason       String?
  proposedAt         DateTime         @default(now())
  reviewedAt         DateTime?
  appliedAt          DateTime?

  @@index([customerContractId, status])
}

model CustomerRateCard {
  id                 String           @id
  customerContractId String
  customerContract   CustomerContract @relation(fields: [customerContractId], references: [id], onDelete: Restrict)
  version            Int
  status             String           @default("PROPOSED") // PROPOSED | APPROVED_SHADOW | REJECTED | SUPERSEDED | EXPIRED
  effectiveAt        DateTime
  expiresAt          DateTime
  rateCardDigest     String
  proposedByUserId   String
  proposalStepUpId   String
  reviewedByUserId   String?
  reviewStepUpId     String?
  reviewReason       String?
  reviewedAt         DateTime?
  createdAt          DateTime         @default(now())
  feeRules           CustomerFeeRule[]
  invoiceStatements  CustomerInvoiceStatement[]

  @@unique([customerContractId, version], map: "CustomerRateCard_contract_version")
  @@index([customerContractId, status, effectiveAt, expiresAt], map: "CustomerRateCard_scope_status_term")
}

model CustomerFeeRule {
  id               String           @id
  customerRateCardId String
  customerRateCard CustomerRateCard @relation(fields: [customerRateCardId], references: [id], onDelete: Restrict)
  transactionRoute String
  representation   String
  lifecycleLeg     String
  metric           String
  feeBasis         String // FIXED_MINOR | NOTIONAL_BASIS_POINTS | PER_UNIT_MINOR
  rateValue        String // canonical non-negative integer text; basis points when feeBasis is NOTIONAL_BASIS_POINTS
  minimumFeeMinor  String?
  maximumFeeMinor  String?
  roundingMode     String // DOWN | HALF_UP
  createdAt        DateTime @default(now())
  invoiceLines     CustomerInvoiceLine[]

  @@unique([customerRateCardId, transactionRoute, representation, lifecycleLeg, metric], map: "CustomerFeeRule_card_route_metric")
}

model CustomerUsageEvent {
  id                 String      @id
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  customerContractId String
  customerContract   CustomerContract @relation(fields: [customerContractId], references: [id], onDelete: Restrict)
  transactionCaseId  String?
  sourceEventRef     String
  sourceEventDigest  String
  transactionRoute   String
  representation     String
  lifecycleLeg       String
  metric             String
  quantityMinor      String
  notionalMinor      String
  currency           String
  occurredAt         DateTime
  status             String      @default("UNBILLED") // UNBILLED | BILLED | REVERSED
  recordedByUserId   String
  recordedAt         DateTime    @default(now())
  invoiceLine        CustomerInvoiceLine?

  @@unique([institutionId, sourceEventRef], map: "CustomerUsageEvent_institution_source")
  @@index([customerContractId, status, occurredAt], map: "CustomerUsageEvent_contract_status_time")
}

model CustomerInvoiceStatement {
  id                 String           @id
  customerContractId String
  customerContract   CustomerContract @relation(fields: [customerContractId], references: [id], onDelete: Restrict)
  customerRateCardId String
  customerRateCard   CustomerRateCard @relation(fields: [customerRateCardId], references: [id], onDelete: Restrict)
  statementRef       String
  periodStart        DateTime
  periodEnd          DateTime
  currency           String
  currencyScale      Int
  grossFeeMinor      String
  creditMinor        String
  netFeeMinor        String
  status             String           @default("DRAFT") // DRAFT | ISSUED_SHADOW | CORRECTED | VOID
  statementDigest    String
  preparedByUserId   String
  preparationStepUpId String
  issuedByUserId     String?
  issueStepUpId      String?
  issueReason        String?
  issuedAt           DateTime?
  createdAt          DateTime         @default(now())
  lines              CustomerInvoiceLine[]
  creditCorrections  CustomerCreditCorrection[]

  @@unique([customerContractId, statementRef], map: "CustomerInvoiceStatement_contract_ref")
  @@index([customerContractId, periodStart, periodEnd], map: "CustomerInvoiceStatement_contract_period_idx")
}

model CustomerInvoiceLine {
  id                 String                   @id
  invoiceStatementId String
  invoiceStatement   CustomerInvoiceStatement @relation(fields: [invoiceStatementId], references: [id], onDelete: Restrict)
  usageEventId       String                   @unique
  usageEvent         CustomerUsageEvent       @relation(fields: [usageEventId], references: [id], onDelete: Restrict)
  feeRuleId          String
  feeRule            CustomerFeeRule          @relation(fields: [feeRuleId], references: [id], onDelete: Restrict)
  basisMinor         String
  rateValue          String
  calculatedFeeMinor String
  calculationDigest String
  createdAt          DateTime                 @default(now())

  @@index([invoiceStatementId])
}

model CustomerCreditCorrection {
  id                 String                   @id
  customerContractId String
  customerContract   CustomerContract         @relation(fields: [customerContractId], references: [id], onDelete: Restrict)
  invoiceStatementId String
  invoiceStatement   CustomerInvoiceStatement @relation(fields: [invoiceStatementId], references: [id], onDelete: Restrict)
  amountMinor        String
  reason             String
  evidenceRef        String
  proposalDigest     String
  status             String                   @default("PROPOSED") // PROPOSED | APPROVED | REJECTED
  proposedByUserId   String
  proposalStepUpId   String
  reviewedByUserId   String?
  reviewStepUpId     String?
  reviewReason       String?
  reviewedAt         DateTime?
  createdAt          DateTime                 @default(now())

  @@index([invoiceStatementId, status])
}

model CustomerImplementationCohort {
  id                 String           @id
  institutionId      String
  institution        Institution      @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  customerContractId String
  customerContract   CustomerContract @relation(fields: [customerContractId], references: [id], onDelete: Restrict)
  cohortRef          String
  operatingMode      String
  routes             Json
  gateRefs           Json
  status             String           @default("PLANNED") // PLANNED | ACTIVE_SHADOW | PAUSED | COMPLETED | CANCELLED
  startsAt           DateTime
  endsAt             DateTime
  ownerUserId        String
  changeReason       String
  changedByUserId    String
  changeStepUpId     String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt

  @@unique([institutionId, cohortRef])
  @@index([institutionId, status, startsAt, endsAt], map: "CustomerImplementationCohort_scope_status_term")
}

model CustomerServiceRequest {
  id                 String      @id
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  transactionCaseId  String?
  requestRef         String
  requestType        String
  priority           String
  subject            String
  description        String
  evidenceRefs       Json
  status             String      @default("OPEN") // OPEN | ACKNOWLEDGED | IN_PROGRESS | WAITING_CUSTOMER | RESOLVED | CLOSED
  slaDueAt           DateTime
  escalationLevel    Int         @default(0)
  escalationPath     Json
  assignedToUserId   String?
  createdByUserId    String
  createdByMandateId String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt
  messages           CustomerServiceMessage[]

  @@unique([institutionId, requestRef])
  @@index([institutionId, status, slaDueAt])
}

model CustomerServiceMessage {
  id                     String                 @id
  customerServiceRequestId String
  customerServiceRequest CustomerServiceRequest @relation(fields: [customerServiceRequestId], references: [id], onDelete: Restrict)
  authorType             String // CUSTOMER | INTERNAL
  authorUserId           String
  body                   String
  evidenceRefs           Json
  createdAt              DateTime               @default(now())

  @@index([customerServiceRequestId, createdAt])
}

model CustomerOperationalReview {
  id                 String      @id
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  periodStart        DateTime
  periodEnd          DateTime
  serviceMetrics     Json
  openItems          Json
  evidenceRefs       Json
  status             String      @default("RECORDED")
  recordedByUserId   String
  stepUpEvidenceId   String
  createdAt          DateTime    @default(now())

  @@index([institutionId, periodEnd])
}

model CustomerDataExitExport {
  id                 String      @id
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  exportVersion      String
  highWaterAt        DateTime
  recordCounts       Json
  manifestDigest     String
  scope              Json
  requestedByUserId  String
  requestedByMandateId String
  stepUpEvidenceId   String
  createdAt          DateTime    @default(now())

  @@index([institutionId, createdAt])
}

model ConnectorSubjectMapping {
  id                      String                @id
  connectorRegistrationId String
  connectorRegistration   ConnectorRegistration @relation(fields: [connectorRegistrationId], references: [id], onDelete: Restrict)
  externalSubjectRef      String
  subjectType             String // INSTITUTION_DID | OTHER_APPROVED
  institutionId           String
  institution             Institution           @relation("ConnectorSubjectInstitution", fields: [institutionId], references: [id], onDelete: Restrict)
  allowedActions          Json
  scopeType               String
  scopeRef                String?
  authorityEvidenceRef    String
  proposalDigest          String                @unique
  status                  String                @default("PROPOSED") // PROPOSED | ACTIVE | REJECTED | SUSPENDED | REVOKED | EXPIRED
  version                 Int                   @default(1)
  supersedesMappingId     String?
  proposedByUserId        String
  proposalStepUpId        String
  approvedByUserId        String?
  approvalStepUpId        String?
  approvalReason          String?
  effectiveAt             DateTime?
  expiresAt               DateTime?
  suspendedAt             DateTime?
  revokedAt               DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt

  @@unique([connectorRegistrationId, externalSubjectRef, version], map: "ConnectorSubjectMapping_connector_subject_version_key")
  @@index([connectorRegistrationId, externalSubjectRef, status], map: "ConnectorSubjectMapping_connector_subject_status_idx")
  @@index([institutionId, status])
}

model ConnectorCertification {
  id                        String                @id
  connectorRegistrationId   String
  connectorRegistration     ConnectorRegistration @relation(fields: [connectorRegistrationId], references: [id], onDelete: Restrict)
  profileRef                String
  schemaId                  String
  schemaVersion             String
  operatingMode             String // REPLAY | SHADOW | CONTROLLED_LIVE | PRODUCTION (live modes require later activation gates)
  status                    String                @default("PROPOSED") // PROPOSED | APPROVED | REJECTED | SUPERSEDED | EXPIRED
  conformanceEvidenceDigest String
  conformanceResult         Json
  qualifications            Json
  reason                    String
  proposedByUserId          String
  proposalStepUpId          String
  reviewedByUserId          String?
  reviewStepUpId            String?
  reviewReason              String?
  effectiveAt               DateTime?
  expiresAt                 DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @default(now()) @updatedAt
  tokenConnectorBindings    TokenConnectorBinding[]

  @@unique([connectorRegistrationId, profileRef, schemaVersion, operatingMode, conformanceEvidenceDigest], map: "ConnectorCertification_evidence_key")
  @@index([connectorRegistrationId, status])
  @@index([expiresAt])
}

model EvidenceObject {
  id                String                   @id
  institutionId     String
  institution       Institution              @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  transactionCaseId String?
  evidenceType      String
  classification    String
  purpose           String
  status            String                   @default("PENDING") // PENDING | AVAILABLE | QUARANTINED | SUPERSEDED | EXPIRED | RETAINED
  currentVersion    Int                      @default(0)
  retentionUntilAt  DateTime
  legalHold         Boolean                  @default(false)
  createdByUserId   String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @default(now()) @updatedAt
  versions          EvidenceVersion[]
  documentFamily    RailDocumentFamily?
  grants            EvidenceAccessGrant[]
  accessReceipts    EvidenceAccessReceipt[]
  retentionEvents   EvidenceRetentionEvent[]
  sagaObservations  SagaLegObservation[]
  recordSnapshots   AuthoritativeRecordSnapshot[]
  daHistoricOutcomeSagas SettlementSaga[] @relation("DaHistoricOutcomeEvidence")
  daCreditDecisionSagas  SettlementSaga[] @relation("DaCreditDecisionEvidence")
  daExecutedDocumentSagas SettlementSaga[] @relation("DaExecutedDocumentEvidence")
  sagaEvidenceLinks SagaEvidenceLink[]
  authoritativeRecordDeclarations AuthoritativeRecordDeclaration[] @relation("DaRecordDeclarationEvidence")
  tokenReconciliationSnapshots TokenReconciliationSnapshot[]
  secondaryTransferEvidence SecondaryTransferEvidence[]
  secondaryTransferRepairs SecondaryTransferRepair[]
  tokenCustodyEvidence TokenConnectorBinding[] @relation("TokenCustodyEvidence")
  tokenLegalFinalityEvidence TokenConnectorBinding[] @relation("TokenLegalFinalityEvidence")
  tokenOperatingAcceptanceEvidence TokenConnectorBinding[] @relation("TokenOperatingAcceptanceEvidence")
  ptcTokenEvidenceGates PtcTokenEvidenceGate[]
  lifecycleEvents RailLifecycleEvent[]

  @@index([institutionId, transactionCaseId])
  @@index([institutionId, status])
  @@index([retentionUntilAt])
}

model EvidenceVersion {
  id                  String                       @id
  evidenceObjectId    String
  evidenceObject      EvidenceObject               @relation(fields: [evidenceObjectId], references: [id], onDelete: Restrict)
  version             Int
  providerReferenceId String?
  providerReference   ProviderReference?           @relation(fields: [providerReferenceId], references: [id], onDelete: Restrict)
  intakeSubmissionId  String?                      @unique
  intakeSubmission    IntakeSubmission?            @relation(fields: [intakeSubmissionId], references: [id], onDelete: Restrict)
  schemaId            String
  schemaVersion       String
  payloadDigest       String
  signatureStatus     String
  result              String
  sourceAsOfAt        DateTime
  expiresAt           DateTime?
  qualifications      Json
  validationStatus    String // VALID | INVALID | QUARANTINED | EXPIRED
  validationDetail    Json
  supersedesVersionId String?
  createdByUserId     String
  createdAt           DateTime                     @default(now())
  institutionSnapshot InstitutionEvidenceSnapshot?
  documentVersion     RailDocumentVersion?
  accessReceipts      EvidenceAccessReceipt[]

  @@unique([evidenceObjectId, version])
  @@unique([evidenceObjectId, payloadDigest])
  @@index([providerReferenceId])
  @@index([payloadDigest])
  @@index([expiresAt])
}

model RailDocumentFamily {
  id                String                @id
  evidenceObjectId  String                @unique
  evidenceObject    EvidenceObject        @relation(fields: [evidenceObjectId], references: [id], onDelete: Restrict)
  institutionId     String
  institution       Institution           @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  transactionCaseId String?
  title             String
  documentType      String
  status            String                @default("ACTIVE") // ACTIVE | SUPERSEDED | RETAINED
  currentVersion    Int                   @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @default(now()) @updatedAt
  versions          RailDocumentVersion[]

  @@index([institutionId, transactionCaseId])
}

model RailDocumentVersion {
  id                  String             @id
  documentFamilyId    String
  documentFamily      RailDocumentFamily @relation(fields: [documentFamilyId], references: [id], onDelete: Restrict)
  evidenceVersionId   String             @unique
  evidenceVersion     EvidenceVersion    @relation(fields: [evidenceVersionId], references: [id], onDelete: Restrict)
  version             Int
  filename            String
  claimedContentType  String
  detectedContentType String
  sizeBytes           Int
  storageRef          String             @unique
  malwareStatus       String // CLEAN | INFECTED | SCAN_FAILED | NOT_SCANNED
  malwareEngine       String?
  malwareSignature    String?
  encryptionClass     String
  objectVersionRef    String?
  createdAt           DateTime           @default(now())

  @@unique([documentFamilyId, version])
  @@index([malwareStatus])
}

model EvidenceAccessGrant {
  id                   String         @id
  evidenceObjectId     String
  evidenceObject       EvidenceObject @relation(fields: [evidenceObjectId], references: [id], onDelete: Restrict)
  granteeInstitutionId String
  purpose              String
  classification       String
  status               String         @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
  expiresAt            DateTime?
  grantedByUserId      String
  revokedAt            DateTime?
  createdAt            DateTime       @default(now())

  @@unique([evidenceObjectId, granteeInstitutionId, purpose], map: "EvidenceAccessGrant_object_grantee_purpose_key")
  @@index([granteeInstitutionId, status])
  @@index([expiresAt])
}

model EvidenceAccessReceipt {
  id                  String           @id
  evidenceObjectId    String
  evidenceObject      EvidenceObject   @relation(fields: [evidenceObjectId], references: [id], onDelete: Restrict)
  evidenceVersionId   String?
  evidenceVersion     EvidenceVersion? @relation(fields: [evidenceVersionId], references: [id], onDelete: Restrict)
  actorUserId         String
  actingInstitutionId String
  action              String
  purpose             String
  requestDigest       String
  receiptDigest       String           @unique
  occurredAt          DateTime         @default(now())

  @@index([evidenceObjectId, occurredAt])
  @@index([actingInstitutionId, occurredAt])
}

model EvidenceRetentionEvent {
  id                 String         @id
  evidenceObjectId   String
  evidenceObject     EvidenceObject @relation(fields: [evidenceObjectId], references: [id], onDelete: Restrict)
  action             String // LEGAL_HOLD_SET | LEGAL_HOLD_RELEASED
  reason             String
  actorUserId        String
  stepUpEvidenceId   String
  priorLegalHold     Boolean
  resultingLegalHold Boolean
  eventDigest        String         @unique
  occurredAt         DateTime       @default(now())

  @@index([evidenceObjectId, occurredAt])
}

model IntakeReceipt {
  id                 String           @id
  intakeSubmissionId String           @unique
  intakeSubmission   IntakeSubmission @relation(fields: [intakeSubmissionId], references: [id], onDelete: Restrict)
  status             String
  receiptDigest      String           @unique
  detail             Json?
  institutionId      String?
  transactionCaseId  String?
  createdAt          DateTime         @default(now())

  @@index([institutionId, createdAt])
  @@index([transactionCaseId, createdAt])
}

// ───────────────── neutral transaction case and governed state engine (PR-06) ───────────────

model TransactionCase {
  id                     String                   @id
  caseReference          String                   @unique
  ownerInstitutionId     String
  ownerInstitution       Institution              @relation("CaseOwnerInstitution", fields: [ownerInstitutionId], references: [id], onDelete: Restrict)
  transactionRoute       String
  representation         String
  jurisdiction           String
  marketContext          String
  placementOrListing     String
  lifecycleLeg           String
  assetClass             String
  operatingMode          String
  routePackRef           String
  routePackVersion       String
  extensionProfileRef    String?
  status                 String                   @default("DRAFT")
  routeState             String                   @default("NOT_STARTED")
  currentVersion         Int                      @default(1)
  aggregateVersion       Int                      @default(1)
  creationIdempotencyKey String
  creationRequestDigest  String
  evidenceLockedAt       DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  createdByUserId        String
  createdByMandateId     String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now()) @updatedAt
  versions               CaseVersion[]
  parties                CaseParty[]
  functionAssignments    CaseFunctionAssignment[]
  conditions             CaseCondition[]
  decisions              CaseDecision[]
  transitions            CaseTransition[]
  replayReceipts         CaseReplayReceipt[]
  rooms                  CaseRoom[]
  roomAuthority          RoomAuthorityAssignment?
  roomAuthorityChanges   RoomAuthorityChange[]
  sourceCompletions      SourceCompletion[]
  daReplayAuthorisation  DaReplayAuthorisation?
  ptcReplayAuthorisation PtcReplayAuthorisation?
  settlementSagas        SettlementSaga[]
  authoritativeRecords   AuthoritativeRecordDeclaration[]
  reconciliationBreaks   ReconciliationBreak[]
  tokenRepresentations   TokenRepresentation[]
  commercialOpportunities CommercialOpportunity[]
  secondaryTransfer       SecondaryTransfer?
  ptcTokenRepresentation  PtcTokenRepresentation?
  lifecyclePlans          RailLifecyclePlan[]
  lifecycleBreaks         RailLifecycleBreak[]
  commercialHandoffs      CommercialCaseHandoff[]

  @@unique([ownerInstitutionId, creationIdempotencyKey])
  @@index([ownerInstitutionId, status])
  @@index([transactionRoute, representation, operatingMode, status])
}

// ───────────────── route-neutral lifecycle product (AR-25) ─────────────────
// Observe-only lifecycle facts. These records neither dispatch an external action nor replace the
// trustee, payment provider, servicer, RTA, depository or other route-defined authoritative record.
model RailLifecyclePlan {
  id                    String          @id
  transactionCaseId     String
  transactionCase       TransactionCase @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  version               Int
  periodStartAt         DateTime
  periodEndAt           DateTime
  executionMode         String          @default("OBSERVE_ONLY")
  status                String          @default("ACTIVE") // ACTIVE | BREAK_OPEN | RECONCILED | PAUSED | CLOSED
  routePackRef          String
  routePackVersion      String
  idempotencyKey        String
  requestDigest         String
  planDigest            String
  createdByUserId       String
  createdByMandateId    String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @default(now()) @updatedAt
  reconciledAt          DateTime?
  obligations           RailLifecycleObligation[]
  breaks                RailLifecycleBreak[]

  @@unique([transactionCaseId, version])
  @@unique([transactionCaseId, idempotencyKey])
  @@index([transactionCaseId, status, periodEndAt])
}

model RailLifecycleObligation {
  id                       String            @id
  lifecyclePlanId          String
  lifecyclePlan            RailLifecyclePlan @relation(fields: [lifecyclePlanId], references: [id], onDelete: Restrict)
  obligationKey            String
  eventType                String
  sequence                 Int
  materialFunction         String
  accountableInstitutionId String
  accountableInstitution   Institution      @relation("LifecycleObligationOwnerInstitution", fields: [accountableInstitutionId], references: [id], onDelete: Restrict)
  performerClass           String
  dueAt                    DateTime
  required                 Boolean           @default(true)
  expected                 Json
  expectedDigest           String
  amountCurrency           String?
  amountMinorUnits         String?
  amountScale              Int?
  state                    String            @default("PLANNED") // PLANNED | OBSERVED | RECONCILED | BREAK_OPEN | PAUSED
  currentEventVersion      Int               @default(0)
  reconciledByUserId       String?
  reconciliationStepUpId   String?
  reconciliationReason     String?
  reconciliationIdempotencyKey String?
  reconciliationRequestDigest  String?
  reconciledAt             DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @default(now()) @updatedAt
  events                   RailLifecycleEvent[]
  breaks                   RailLifecycleBreak[]

  @@unique([lifecyclePlanId, obligationKey])
  @@unique([lifecyclePlanId, sequence])
  @@unique([lifecyclePlanId, reconciliationIdempotencyKey], map: "RailLifecycleObligation_plan_reconcile_key")
  @@index([lifecyclePlanId, state, sequence])
  @@index([accountableInstitutionId, dueAt, state], map: "RailLifecycleObligation_owner_due_state_idx")
}

model RailLifecycleEvent {
  id                    String                  @id
  lifecycleObligationId String
  lifecycleObligation   RailLifecycleObligation @relation(fields: [lifecycleObligationId], references: [id], onDelete: Restrict)
  version               Int
  idempotencyKey        String
  requestDigest         String
  observed              Json
  observedDigest        String
  externalReference     String
  finalityClass         String
  signatureStatus       String
  evidenceObjectId      String
  evidenceObject        EvidenceObject          @relation(fields: [evidenceObjectId], references: [id], onDelete: Restrict)
  observedAt            DateTime
  recordedByUserId      String
  recordedByMandateId   String
  comparisonResult      String // MATCHED | BREAK_OPEN
  comparison            Json
  createdAt             DateTime                @default(now())
  break                 RailLifecycleBreak?

  @@unique([lifecycleObligationId, version])
  @@unique([lifecycleObligationId, idempotencyKey])
  @@index([evidenceObjectId])
}

model RailLifecycleBreak {
  id                    String                  @id
  transactionCaseId     String
  transactionCase       TransactionCase         @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  lifecyclePlanId       String
  lifecyclePlan         RailLifecyclePlan        @relation(fields: [lifecyclePlanId], references: [id], onDelete: Restrict)
  lifecycleObligationId String
  lifecycleObligation   RailLifecycleObligation  @relation(fields: [lifecycleObligationId], references: [id], onDelete: Restrict)
  lifecycleEventId      String                  @unique
  lifecycleEvent        RailLifecycleEvent       @relation(fields: [lifecycleEventId], references: [id], onDelete: Restrict)
  breakCode             String
  severity              String
  expectedDigest        String
  observedDigest        String
  blockedCapabilities   Json
  status                String                  @default("OPEN") // OPEN | RESOLVED
  ownerInstitutionId    String
  ownerInstitution      Institution             @relation("LifecycleBreakOwnerInstitution", fields: [ownerInstitutionId], references: [id], onDelete: Restrict)
  dueAt                 DateTime
  openedByUserId        String
  resolutionEvidenceRef String?
  resolvedByUserId      String?
  resolvedAt            DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt

  @@index([transactionCaseId, status, dueAt])
  @@index([lifecyclePlanId, status])
  @@index([lifecycleObligationId, status])
  @@index([ownerInstitutionId, status, dueAt])
}

model CaseVersion {
  id                  String          @id
  transactionCaseId   String
  transactionCase     TransactionCase @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  version             Int
  spec                Json
  specDigest          String
  reason              String
  supersedesVersionId String?
  createdByUserId     String
  createdByMandateId  String
  createdAt           DateTime        @default(now())

  @@unique([transactionCaseId, version])
  @@unique([transactionCaseId, specDigest])
}

model CaseParty {
  id                   String          @id
  transactionCaseId    String
  transactionCase      TransactionCase @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  institutionId        String
  institution          Institution     @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  partyRole            String
  status               String          @default("PROPOSED")
  authorityMandateId   String?
  appointmentId        String?
  authorityEvidenceRef String
  acceptedByUserId     String?
  acceptedAt           DateTime?
  createdByUserId      String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt
  commercialHandoffs   CommercialCaseHandoff[]

  @@unique([transactionCaseId, institutionId, partyRole])
  @@index([institutionId, status])
  @@index([transactionCaseId, status])
}

model CaseFunctionAssignment {
  id                     String          @id
  transactionCaseId      String
  transactionCase        TransactionCase @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  materialFunction       String
  performer              String
  performerInstitutionId String?
  performerInstitution   Institution?    @relation("FunctionPerformerInstitution", fields: [performerInstitutionId], references: [id], onDelete: Restrict)
  appointmentId          String?
  authorityEvidenceRef   String?
  permissionEvidenceRef  String?
  status                 String          @default("PROPOSED")
  effectiveAt            DateTime?
  expiresAt              DateTime?
  createdByUserId        String
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt

  @@unique([transactionCaseId, materialFunction])
  @@index([performerInstitutionId, status])
}

model CaseCondition {
  id                 String          @id
  transactionCaseId  String
  transactionCase    TransactionCase @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  conditionKind      String
  code               String
  description        String
  ownerInstitutionId String
  dueAt              DateTime?
  status             String          @default("OPEN")
  evidenceObjectId   String?
  waiverAuthorityRef String?
  resolutionReason   String?
  resolvedByUserId   String?
  resolvedAt         DateTime?
  createdByUserId    String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt

  @@unique([transactionCaseId, code])
  @@index([transactionCaseId, status, dueAt])
  @@index([ownerInstitutionId, status])
}

model CaseDecision {
  id                   String          @id
  transactionCaseId    String
  transactionCase      TransactionCase @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  decisionType         String
  proposal             Json
  proposalDigest       String
  rulePackRef          String
  rulePackVersion      String
  evidenceBundleDigest String
  caseAggregateVersion Int
  status               String          @default("PROPOSED")
  reason               String
  proposedByUserId     String
  proposedByMandateId  String
  proposalStepUpId     String
  reviewedByUserId     String?
  reviewStepUpId       String?
  reviewReason         String?
  effectiveAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt
  approvals            CaseApproval[]

  @@unique([transactionCaseId, decisionType, proposalDigest])
  @@index([transactionCaseId, status])
}

model CaseApproval {
  id               String       @id
  caseDecisionId   String
  caseDecision     CaseDecision @relation(fields: [caseDecisionId], references: [id], onDelete: Restrict)
  outcome          String
  checkerUserId    String
  checkerMandateId String
  stepUpEvidenceId String
  reason           String
  approvalDigest   String       @unique
  createdAt        DateTime     @default(now())

  @@unique([caseDecisionId, checkerUserId])
}

model CaseTransition {
  id                   String          @id
  transactionCaseId    String
  transactionCase      TransactionCase @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  command              String
  idempotencyKey       String
  requestDigest        String
  fromStatus           String
  toStatus             String
  expectedVersion      Int
  resultingVersion     Int
  guardResult          Json
  evidenceBundleDigest String
  rulePackRef          String
  rulePackVersion      String
  actorUserId          String
  actingInstitutionId  String
  authorityMandateId   String
  stepUpEvidenceId     String
  transitionDigest     String          @unique
  occurredAt           DateTime        @default(now())

  @@unique([transactionCaseId, idempotencyKey])
  @@unique([transactionCaseId, resultingVersion])
  @@index([transactionCaseId, occurredAt])
}

model CaseReplayReceipt {
  id                String          @id
  transactionCaseId String
  transactionCase   TransactionCase @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  aggregateVersion  Int
  exportDigest      String
  replayDigest      String
  result            String
  detail            Json
  requestedByUserId String
  createdAt         DateTime        @default(now())

  @@unique([transactionCaseId, aggregateVersion, replayDigest])
  @@index([transactionCaseId, createdAt])
}

// ───────────────── Rail-owned case rooms and sealed legacy evidence (PR-07) ───────────────

model CaseRoom {
  id                     String             @id
  transactionCaseId      String
  transactionCase        TransactionCase    @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  purpose                String // PASSIVE_DILIGENCE; commercial negotiation remains prohibited in PR-07
  policyVersion          String
  sourceReferenceId      String?
  sourceReference        SourceReference?   @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict)
  sourceManifestDigest   String?
  status                 String             @default("DARK_IMPORTED") // DARK_IMPORTED | OPEN | CLOSED | WITHDRAWN | BLOCKED
  aggregateVersion       Int                @default(1)
  creationIdempotencyKey String?
  creationRequestDigest  String?
  closeIdempotencyKey    String?
  closeRequestDigest     String?
  closeReason            String?
  legacyRoomId           String?            @unique
  legacyPoolId           String?
  legacyClaId            String?
  legacyPurpose          String?
  legacySourceSystem     String?
  legacySourceVersion    String?
  openedAt               DateTime?
  closedAt               DateTime?
  createdByUserId        String
  createdByMandateId     String
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @default(now()) @updatedAt
  grants                 RoomGrant[]
  accessEvents           RoomAccessEvent[]
  messages               RoomMessage[]
  legacyImports          LegacyRoomImport[]

  @@unique([transactionCaseId, creationIdempotencyKey], map: "CaseRoom_case_creation_idempotency_key")
  @@unique([transactionCaseId, closeIdempotencyKey], map: "CaseRoom_case_close_idempotency_key")
  @@index([transactionCaseId, status])
  @@index([sourceReferenceId])
}

model RoomGrant {
  id                       String      @id
  caseRoomId               String
  caseRoom                 CaseRoom    @relation(fields: [caseRoomId], references: [id], onDelete: Restrict)
  granteeInstitutionId     String
  granteeInstitution       Institution @relation("RoomGrantInstitution", fields: [granteeInstitutionId], references: [id], onDelete: Restrict)
  purpose                  String
  classification           String
  status                   String      @default("PROPOSED") // PROPOSED | ACTIVE | REVOKED | EXPIRED | MIGRATED_DARK
  grantVersion             Int         @default(1)
  invitationIdempotencyKey String?
  invitationRequestDigest  String?
  invitationDigest         String?     @unique
  invitationExpiresAt      DateTime?
  declarationTextVersion   String
  relianceTextVersion      String
  declarationDigest        String?
  declarationAt            DateTime?
  relianceAcceptedAt       DateTime?
  expiresAt                DateTime?
  legacyInviteId           String?
  legacyTransfereeDid      String?
  legacyStatus             String?
  grantedByUserId          String
  grantedByMandateId       String?
  acceptedByUserId         String?
  acceptedByMandateId      String?
  acceptedAt               DateTime?
  acceptanceIdempotencyKey String?
  acceptanceRequestDigest  String?
  revokedByUserId          String?
  revokedAt                DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @default(now()) @updatedAt

  @@unique([caseRoomId, granteeInstitutionId, purpose])
  @@unique([caseRoomId, legacyInviteId])
  @@unique([caseRoomId, invitationIdempotencyKey], map: "RoomGrant_room_invitation_idempotency_key")
  @@unique([caseRoomId, acceptanceIdempotencyKey], map: "RoomGrant_room_acceptance_idempotency_key")
  @@index([granteeInstitutionId, status])
  @@index([caseRoomId, status])
}

model RoomAuthorityAssignment {
  id                       String                @id
  transactionCaseId        String                @unique
  transactionCase          TransactionCase       @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  writeSource              String                @default("LEGACY") // LEGACY | RAIL
  state                    String                @default("ACTIVE") // ACTIVE | PAUSED
  cohortRef                String?
  legacyCompatibilityUntil DateTime?
  version                  Int                   @default(1)
  lastChangeId             String?               @unique
  allocatedByUserId        String
  allocatedByMandateId     String
  allocatedAt              DateTime              @default(now())
  updatedAt                DateTime              @default(now()) @updatedAt
  changes                  RoomAuthorityChange[]

  @@index([writeSource, state, cohortRef])
}

model RoomAuthorityChange {
  id                       String                   @id
  transactionCaseId        String
  transactionCase          TransactionCase          @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  assignmentId             String?
  assignment               RoomAuthorityAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  command                  String // ALLOCATE_RAIL | PAUSE_RAIL | RESUME_RAIL | RETURN_LEGACY
  expectedVersion          Int
  fromWriteSource          String
  fromState                String
  toWriteSource            String
  toState                  String
  cohortRef                String?
  legacyCompatibilityUntil DateTime?
  reason                   String
  authorityEvidenceRef     String
  proposalDigest           String
  status                   String                   @default("PENDING") // PENDING | APPROVED | REJECTED | SUPERSEDED
  proposedByUserId         String
  proposedByMandateId      String
  proposalStepUpId         String
  approvedByUserId         String?
  approvedByMandateId      String?
  approvalStepUpId         String?
  reviewNote               String?
  proposedAt               DateTime                 @default(now())
  reviewedAt               DateTime?
  appliedAt                DateTime?

  @@unique([transactionCaseId, proposalDigest])
  @@index([transactionCaseId, status, proposedAt])
}

model RoomAccessEvent {
  id                  String   @id
  caseRoomId          String
  caseRoom            CaseRoom @relation(fields: [caseRoomId], references: [id], onDelete: Restrict)
  sequence            BigInt
  chainOrigin         String // LEGACY | RAIL
  hashRoomReference   String // exact room ID committed inside this event's hash payload
  actorUserId         String?
  actingInstitutionId String?
  actorReference      String
  action              String
  objectReference     String?
  previousHash        String
  eventHash           String   @unique
  occurredAt          DateTime
  createdAt           DateTime @default(now())

  @@unique([caseRoomId, sequence])
  @@index([caseRoomId, occurredAt])
}

model RoomMessage {
  id                    String   @id
  caseRoomId            String
  caseRoom              CaseRoom @relation(fields: [caseRoomId], references: [id], onDelete: Restrict)
  authorUserId          String?
  authorInstitutionId   String?
  authorReference       String
  authorRole            String
  messageKind           String
  body                  String
  bodyDigest            String
  messageIdempotencyKey String?
  messageRequestDigest  String?
  legacyMessageId       String?  @unique
  occurredAt            DateTime
  createdAt             DateTime @default(now())

  @@unique([caseRoomId, messageIdempotencyKey], map: "RoomMessage_room_message_idempotency_key")
  @@index([caseRoomId, occurredAt])
}

model LegacyRoomImport {
  id                  String           @id
  caseRoomId          String
  caseRoom            CaseRoom         @relation(fields: [caseRoomId], references: [id], onDelete: Restrict)
  migrationReceiptId  String           @unique
  migrationReceipt    MigrationReceipt @relation(fields: [migrationReceiptId], references: [id], onDelete: Restrict)
  migrationBatchId    String
  sourceSystem        String
  sourceVersion       String
  legacyRoomId        String
  importVersion       Int
  exportDigest        String
  sourceHighWaterMark String
  sourceCounts        Json
  chainTailHash       String
  sealedExport        Json
  status              String           @default("IMPORTED_UNVERIFIED") // IMPORTED_UNVERIFIED | PARITY_MATCHED | BREAK_OPEN | RETIRED
  importedByUserId    String
  reviewedByUserId    String?
  reviewedAt          DateTime?
  createdAt           DateTime         @default(now())
  parityRuns          RoomParityRun[]

  @@unique([sourceSystem, legacyRoomId, exportDigest])
  @@unique([caseRoomId, importVersion])
  @@index([status, createdAt])
}

model RoomParityRun {
  id                     String            @id
  legacyRoomImportId     String
  legacyRoomImport       LegacyRoomImport  @relation(fields: [legacyRoomImportId], references: [id], onDelete: Restrict)
  expectedExportDigest   String
  observedSnapshotDigest String
  result                 String // MATCHED | BREAK_OPEN
  comparisons            Json
  mismatchCount          Int
  runByUserId            String
  runAt                  DateTime          @default(now())
  reviewedByUserId       String?
  reviewedAt             DateTime?
  breaks                 RoomParityBreak[]

  @@index([legacyRoomImportId, runAt])
  @@index([result, runAt])
}

model RoomParityBreak {
  id                 String        @id
  roomParityRunId    String
  roomParityRun      RoomParityRun @relation(fields: [roomParityRunId], references: [id], onDelete: Restrict)
  dimension          String
  severity           String
  expected           Json
  observed           Json
  status             String        @default("OPEN") // OPEN | REPAIR_IN_PROGRESS | RESOLVED
  ownerReference     String?
  resolutionEvidence Json?
  resolvedByUserId   String?
  resolvedAt         DateTime?
  createdAt          DateTime      @default(now())

  @@index([status, severity, createdAt])
  @@index([roomParityRunId, dimension])
}

model IdempotencyRecord {
  id                String    @id
  scope             String
  key               String
  requestDigest     String
  status            String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | FAILED
  responseDigest    String?
  response          Json?
  institutionId     String?
  transactionCaseId String?
  expiresAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@unique([scope, key])
  @@index([status, createdAt])
  @@index([institutionId])
  @@index([transactionCaseId])
}

model InboxMessage {
  id                  String            @id
  providerReferenceId String
  providerReference   ProviderReference @relation(fields: [providerReferenceId], references: [id], onDelete: Restrict)
  externalMessageId   String
  idempotencyKey      String
  schemaId            String
  schemaVersion       String
  payloadDigest       String
  payload             Json?
  storageRef          String?
  signatureStatus     String
  state               String            @default("RECEIVED") // RECEIVED | PROCESSING | PROCESSED | REJECTED | CONFLICT
  institutionId       String?
  transactionCaseId   String?
  processedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now()) @updatedAt

  @@unique([providerReferenceId, externalMessageId])
  @@unique([providerReferenceId, idempotencyKey])
  @@index([state, createdAt])
  @@index([payloadDigest])
  @@index([institutionId])
  @@index([transactionCaseId])
}

model OutboxMessage {
  id                String            @id
  eventLogId        String?           @unique
  eventLog          EventLog?         @relation(fields: [eventLogId], references: [id], onDelete: Restrict)
  event             String
  schemaId          String
  schemaVersion     String
  payloadDigest     String
  payload           Json
  aggregateId       String?
  aggregateVersion  Int?
  institutionId     String?
  transactionCaseId String?
  idempotencyKey    String            @unique
  correlationId     String?
  causationId       String?
  state             String            @default("PENDING") // PENDING | PROCESSING | FANOUT_COMPLETE | RETRY | DEAD_LETTER
  attemptCount      Int               @default(0)
  nextAttemptAt     DateTime          @default(now())
  lockedAt          DateTime?
  lockOwner         String?
  lastError         String?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  webhookDeliveries WebhookDelivery[]

  @@index([state, nextAttemptAt])
  @@index([aggregateId, aggregateVersion])
  @@index([institutionId, createdAt])
  @@index([transactionCaseId, createdAt])
}

model ExternalInstruction {
  id                  String                    @id
  providerReferenceId String
  providerReference   ProviderReference         @relation(fields: [providerReferenceId], references: [id], onDelete: Restrict)
  instructionType     String
  idempotencyKey      String
  requestDigest       String
  request             Json?
  storageRef          String?
  state               String                    @default("PENDING") // PENDING | SHADOW_RECORDED | SENT | ACKNOWLEDGED | AMBIGUOUS | FAILED | CANCELLED
  attemptCount        Int                       @default(0)
  nextAttemptAt       DateTime                  @default(now())
  lockedAt            DateTime?
  lockOwner           String?
  lastError           String?
  institutionId       String?
  transactionCaseId   String?
  sentAt              DateTime?
  terminalAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @default(now()) @updatedAt
  acknowledgements    ExternalAcknowledgement[]
  sourceCompletion    SourceCompletion?
  tokenAction         TokenAction?

  @@unique([providerReferenceId, idempotencyKey])
  @@index([state, nextAttemptAt])
  @@index([institutionId])
  @@index([transactionCaseId])
}

model ExternalAcknowledgement {
  id                        String              @id
  externalInstructionId     String
  externalInstruction       ExternalInstruction @relation(fields: [externalInstructionId], references: [id], onDelete: Restrict)
  providerReferenceId       String
  providerReference         ProviderReference   @relation(fields: [providerReferenceId], references: [id], onDelete: Restrict)
  externalAcknowledgementId String
  status                    String
  finalityClass             String
  responseDigest            String
  response                  Json?
  storageRef                String?
  signatureStatus           String
  acknowledgedAt            DateTime
  institutionId             String?
  transactionCaseId         String?
  createdAt                 DateTime            @default(now())
  sourceCompletionFinal     SourceCompletion?   @relation("SourceCompletionFinalAcknowledgement")

  @@unique([providerReferenceId, externalAcknowledgementId], map: "ExternalAck_provider_external_id_key")
  @@unique([externalInstructionId, responseDigest], map: "ExternalAck_instruction_response_key")
  @@index([externalInstructionId, acknowledgedAt], map: "ExternalAck_instruction_acknowledged_idx")
  @@index([institutionId])
  @@index([transactionCaseId])
}

model SourceCompletion {
  id                       String                   @id
  transactionCaseId        String
  transactionCase          TransactionCase          @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  sourceReferenceId        String
  sourceReference          SourceReference          @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict)
  providerReferenceId      String
  providerReference        ProviderReference        @relation(fields: [providerReferenceId], references: [id], onDelete: Restrict)
  connectorRegistrationId  String
  connectorRegistration    ConnectorRegistration    @relation(fields: [connectorRegistrationId], references: [id], onDelete: Restrict)
  completionKind           String
  idempotencyKey           String
  requestDigest            String
  completionEvidenceRef    String
  completionEvidenceDigest String
  expectedSourceObjectId   String
  expectedSourceVersion    String
  expectedManifestDigest   String
  expectedLockReference    String?
  dispatchMode             String // SHADOW | ON
  state                    String                   @default("PENDING") // PENDING | SHADOW_RECORDED | DISPATCHING | ACKNOWLEDGED | RECONCILED | BREAK_OPEN | FAILED | PAUSED
  externalInstructionId    String                   @unique
  externalInstruction      ExternalInstruction      @relation(fields: [externalInstructionId], references: [id], onDelete: Restrict)
  finalAcknowledgementId   String?                  @unique
  finalAcknowledgement     ExternalAcknowledgement? @relation("SourceCompletionFinalAcknowledgement", fields: [finalAcknowledgementId], references: [id], onDelete: Restrict)
  observedSourceObjectId   String?
  observedSourceState      String?
  observedSourceVersion    String?
  observedManifestDigest   String?
  observedLockReference    String?
  reconciliationState      String                   @default("PENDING")
  breakCode                String?
  breakDetail              Json?
  initiatedByUserId        String
  initiatedByMandateId     String
  reconciledByUserId       String?
  reconciledAt             DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @default(now()) @updatedAt

  @@unique([transactionCaseId, sourceReferenceId])
  @@unique([providerReferenceId, idempotencyKey])
  @@index([state, createdAt])
  @@index([reconciliationState, updatedAt])
}

// ───────────────── conventional DA replay and durable external-action saga (PR-09) ───────────────
// PR-09 is intentionally OBSERVE_ONLY. These records preserve the order, expected facts, historic
// observations, reconciliation and repair evidence without dispatching money/title/register actions.
// Live instructions remain prohibited until a later route-specific controlled-live gate.

model DaReplayAuthorisation {
  id                    String          @id
  transactionCaseId     String          @unique
  transactionCase       TransactionCase @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  idempotencyKey        String
  requestDigest         String
  authorityEvidenceRef  String
  reason                String
  status                String          @default("PROPOSED") // PROPOSED | APPROVED | REJECTED | REVOKED
  proposedByUserId      String
  proposedByMandateId   String
  proposalStepUpId      String
  reviewedByUserId      String?
  reviewedByMandateId   String?
  reviewStepUpId        String?
  reviewReason          String?
  reviewIdempotencyKey  String?
  reviewRequestDigest   String?
  effectiveAt           DateTime?
  revokedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @default(now()) @updatedAt

  @@unique([transactionCaseId, idempotencyKey])
  @@index([status, createdAt])
}

model PtcReplayAuthorisation {
  id                    String          @id
  transactionCaseId     String          @unique
  transactionCase       TransactionCase @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  idempotencyKey        String
  requestDigest         String
  authorityEvidenceRef  String
  reason                String
  status                String          @default("PROPOSED") // PROPOSED | APPROVED | REJECTED | REVOKED
  proposedByUserId      String
  proposedByMandateId   String
  proposalStepUpId      String
  reviewedByUserId      String?
  reviewedByMandateId   String?
  reviewStepUpId        String?
  reviewReason          String?
  reviewIdempotencyKey  String?
  reviewRequestDigest   String?
  effectiveAt           DateTime?
  revokedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @default(now()) @updatedAt

  @@unique([transactionCaseId, idempotencyKey])
  @@index([status, createdAt])
}

model SettlementSaga {
  id                       String          @id
  transactionCaseId        String
  transactionCase          TransactionCase @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  sagaVersion              Int             @default(1)
  routePackRef             String
  routePackVersion         String
  transactionRoute         String          @default("DA") // DA | PTC; must agree with TransactionCase
  executionMode            String          @default("OBSERVE_ONLY") // OBSERVE_ONLY in PR-09
  state                    String          @default("READY") // READY | EXECUTING | OBSERVED | RECONCILED | BREAK_OPEN | PAUSED | FAILED
  idempotencyKey           String
  requestDigest            String
  planDigest               String
  routeEvidenceBundleDigest String
  legalMechanism           String
  considerationCurrency    String
  considerationMinorUnits  String
  considerationScale       Int
  historicOutcomeRef       String
  historicOutcomeDigest    String
  historicOutcomeEvidenceObjectId String?
  historicOutcomeEvidenceObject   EvidenceObject? @relation("DaHistoricOutcomeEvidence", fields: [historicOutcomeEvidenceObjectId], references: [id], onDelete: Restrict)
  transfereeCreditDecisionEvidenceObjectId String?
  transfereeCreditDecisionEvidenceObject   EvidenceObject? @relation("DaCreditDecisionEvidence", fields: [transfereeCreditDecisionEvidenceObjectId], references: [id], onDelete: Restrict)
  executedTransferDocumentEvidenceObjectId String?
  executedTransferDocumentEvidenceObject   EvidenceObject? @relation("DaExecutedDocumentEvidence", fields: [executedTransferDocumentEvidenceObjectId], references: [id], onDelete: Restrict)
  expectedOutcome          Json
  expectedOutcomeDigest    String
  createdByUserId          String
  createdByMandateId       String
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @default(now()) @updatedAt
  reconciledAt             DateTime?
  legs                     SettlementLeg[]
  recordSnapshots          AuthoritativeRecordSnapshot[]
  breaks                   ReconciliationBreak[]
  evidenceLinks            SagaEvidenceLink[]

  @@unique([transactionCaseId, sagaVersion])
  @@unique([transactionCaseId, idempotencyKey])
  @@index([transactionCaseId, state])
  @@index([state, updatedAt])
  @@index([historicOutcomeEvidenceObjectId])
  @@index([transfereeCreditDecisionEvidenceObjectId])
  @@index([executedTransferDocumentEvidenceObjectId])
}

model SagaEvidenceLink {
  id                 String          @id
  settlementSagaId   String
  settlementSaga     SettlementSaga @relation(fields: [settlementSagaId], references: [id], onDelete: Restrict)
  evidenceObjectId   String
  evidenceObject     EvidenceObject  @relation(fields: [evidenceObjectId], references: [id], onDelete: Restrict)
  evidenceRole       String
  evidenceDigest     String
  required           Boolean         @default(true)
  sequence           Int
  createdAt          DateTime        @default(now())

  @@unique([settlementSagaId, evidenceRole])
  @@unique([settlementSagaId, sequence])
  @@index([evidenceObjectId])
}

model SettlementLeg {
  id                            String          @id
  settlementSagaId              String
  settlementSaga                SettlementSaga @relation(fields: [settlementSagaId], references: [id], onDelete: Restrict)
  legKey                        String
  legType                       String
  sequence                      Int
  required                      Boolean         @default(true)
  participantOwnerInstitutionId String
  performerClass                String
  expected                      Json
  expectedDigest                String
  state                         String          @default("PLANNED") // PLANNED | OBSERVED | RECONCILED | BREAK_OPEN | PAUSED
  currentObservationVersion     Int             @default(0)
  reconciledByUserId            String?
  reconciliationStepUpId        String?
  reconciliationReason          String?
  reconciliationIdempotencyKey  String?
  reconciliationRequestDigest   String?
  reconciledAt                  DateTime?
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @default(now()) @updatedAt
  observations                  SagaLegObservation[]
  breaks                        ReconciliationBreak[]

  @@unique([settlementSagaId, legKey])
  @@unique([settlementSagaId, sequence])
  @@unique([settlementSagaId, reconciliationIdempotencyKey], map: "SettlementLeg_saga_reconciliation_idempotency_key")
  @@index([settlementSagaId, state, sequence])
}

model SagaLegObservation {
  id                  String          @id
  settlementLegId     String
  settlementLeg       SettlementLeg   @relation(fields: [settlementLegId], references: [id], onDelete: Restrict)
  version             Int
  idempotencyKey      String
  requestDigest       String
  observation         Json
  observationDigest   String
  externalReference   String
  finalityClass       String
  signatureStatus     String
  evidenceObjectId    String
  evidenceObject      EvidenceObject  @relation(fields: [evidenceObjectId], references: [id], onDelete: Restrict)
  observedAt          DateTime
  recordedByUserId    String
  recordedByMandateId String
  comparisonResult    String // MATCHED | BREAK_OPEN
  comparison          Json
  createdAt           DateTime        @default(now())
  appliedRepairs      SagaRepairAction[] @relation("AppliedRepairObservation")

  @@unique([settlementLegId, version])
  @@unique([settlementLegId, idempotencyKey])
  @@index([settlementLegId, createdAt])
  @@index([evidenceObjectId])
}

model AuthoritativeRecordDeclaration {
  id                        String           @id
  transactionCaseId         String           @unique
  transactionCase           TransactionCase  @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  recordType                String
  authorityClass            String
  recordkeeperInstitutionId String?
  recordkeeperInstitution   Institution?     @relation("AuthoritativeRecordkeeperInstitution", fields: [recordkeeperInstitutionId], references: [id], onDelete: Restrict)
  sourceReferenceId         String?
  sourceReference           SourceReference? @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict)
  declarationEvidenceRef    String
  declarationEvidenceDigest String
  declarationEvidenceObjectId String
  declarationEvidenceObject   EvidenceObject @relation("DaRecordDeclarationEvidence", fields: [declarationEvidenceObjectId], references: [id], onDelete: Restrict)
  routePackRef              String
  routePackVersion          String
  status                    String           @default("ACTIVE") // ACTIVE | SUPERSEDED | REVOKED
  createdByUserId           String
  createdByMandateId        String
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @default(now()) @updatedAt
  snapshots                 AuthoritativeRecordSnapshot[]
  tokenRepresentations      TokenRepresentation[]
  ptcTokenRepresentations   PtcTokenRepresentation[]

  @@index([recordkeeperInstitutionId, status])
  @@index([sourceReferenceId])
  @@index([declarationEvidenceObjectId])
}

// ───────────────── tokenised PTC shadow route (PR-16) ─────────────────
// This is separate from the DA Note/token projection. It records a PTC class/tranche mirror and
// explicit external evidence gates; it has no live instruction or dispatch path in PR-16.
model PtcTokenRepresentation {
  id                               String                         @id
  transactionCaseId                String                         @unique
  transactionCase                  TransactionCase                @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  programmeReference               String
  trustReference                   String
  classReference                   String
  trancheDefinitionDigest          String
  trusteeInstitutionId             String
  trusteeInstitution               Institution                    @relation("PtcTokenTrusteeInstitution", fields: [trusteeInstitutionId], references: [id], onDelete: Restrict)
  recordkeeperInstitutionId        String
  recordkeeperInstitution          Institution                    @relation("PtcTokenRecordkeeperInstitution", fields: [recordkeeperInstitutionId], references: [id], onDelete: Restrict)
  assuranceProviderInstitutionId   String?
  assuranceProviderInstitution     Institution?                   @relation("PtcTokenAssuranceInstitution", fields: [assuranceProviderInstitutionId], references: [id], onDelete: Restrict)
  authoritativeRecordDeclarationId String
  authoritativeRecordDeclaration   AuthoritativeRecordDeclaration @relation(fields: [authoritativeRecordDeclarationId], references: [id], onDelete: Restrict)
  network                          String
  tokenId                          String
  authorityMode                    String                         @default("MIRROR")
  status                           String                         @default("EVIDENCE_OPEN") // EVIDENCE_OPEN | PROPOSED | SHADOW_READY | REJECTED | SUSPENDED
  routePackRef                     String
  routePackVersion                 String
  idempotencyKey                   String
  requestDigest                    String
  proposedByUserId                 String
  proposedByMandateId              String
  proposalStepUpId                 String
  proposedAt                       DateTime                       @default(now())
  reviewedByUserId                 String?
  reviewedByMandateId              String?
  reviewStepUpId                   String?
  reviewReason                     String?
  reviewedAt                       DateTime?
  createdAt                        DateTime                       @default(now())
  updatedAt                        DateTime                       @default(now()) @updatedAt
  evidenceGates                    PtcTokenEvidenceGate[]
  actionPlans                      PtcTokenActionPlan[]

  @@unique([transactionCaseId, idempotencyKey])
  @@unique([network, tokenId])
  @@index([trusteeInstitutionId, status])
  @@index([recordkeeperInstitutionId, status])
}

model PtcTokenEvidenceGate {
  id                       String                 @id
  ptcTokenRepresentationId String
  ptcTokenRepresentation   PtcTokenRepresentation @relation(fields: [ptcTokenRepresentationId], references: [id], onDelete: Restrict)
  gateCode                 String
  expectedEvidenceType     String
  accountableInstitutionId String
  accountableInstitution   Institution             @relation("PtcTokenGateAccountableInstitution", fields: [accountableInstitutionId], references: [id], onDelete: Restrict)
  evidenceObjectId         String?
  evidenceObject           EvidenceObject?        @relation(fields: [evidenceObjectId], references: [id], onDelete: Restrict)
  evidenceDigest           String?
  status                   String                 @default("OPEN") // OPEN | VERIFIED | FAILED | EXPIRED
  qualification            String?
  sourceAsOfAt             DateTime?
  expiresAt                DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @default(now()) @updatedAt

  @@unique([ptcTokenRepresentationId, gateCode])
  @@index([status, expiresAt])
  @@index([evidenceObjectId])
}

model PtcTokenActionPlan {
  id                       String                 @id
  ptcTokenRepresentationId String
  ptcTokenRepresentation   PtcTokenRepresentation @relation(fields: [ptcTokenRepresentationId], references: [id], onDelete: Restrict)
  actionType               String // ISSUE | TRANSFER | DISTRIBUTION | LIFECYCLE_ANCHOR | BURN
  sequence                 Int
  candidateCapabilityId    String
  state                    String                 @default("BLOCKED") // BLOCKED | SHADOW_READY
  blockingGateCodes        Json
  planDigest               String
  createdAt                DateTime               @default(now())

  @@unique([ptcTokenRepresentationId, actionType])
  @@unique([ptcTokenRepresentationId, sequence])
  @@index([ptcTokenRepresentationId, state])
}

// ───────────────── tokenised-DA representation adapter (PR-11) ───────────────
// The token is a route projection. `authorityMode` is deliberately fixed to MIRROR by the PR-11
// service; neither this record nor the legacy Note ledger becomes the legally operative register.
model TokenRepresentation {
  id                               String                         @id
  transactionCaseId                String                         @unique
  transactionCase                  TransactionCase                @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  noteId                           String                         @unique
  note                             Note                           @relation(fields: [noteId], references: [id], onDelete: Restrict)
  authoritativeRecordDeclarationId String
  authoritativeRecordDeclaration   AuthoritativeRecordDeclaration @relation(fields: [authoritativeRecordDeclarationId], references: [id], onDelete: Restrict)
  representationType               String                         @default("TOKENISED")
  authorityMode                    String                         @default("MIRROR")
  network                          String
  tokenId                          String
  unitsScale                       Int                            @default(0)
  status                           String                         @default("LINKED") // LINKED | RECONCILED | ACTION_PENDING | BREAK_OPEN | SUSPENDED
  linkageIdempotencyKey            String
  linkageRequestDigest             String
  linkedByUserId                   String
  linkedByMandateId                String
  linkageStepUpId                  String
  linkedAt                         DateTime                       @default(now())
  updatedAt                        DateTime                       @default(now()) @updatedAt
  actions                          TokenAction[]
  reconciliationSnapshots          TokenReconciliationSnapshot[]
  breaks                           TokenReconciliationBreak[]
  connectorBindings                TokenConnectorBinding[]

  @@unique([transactionCaseId, linkageIdempotencyKey], map: "TokenRepresentation_case_linkage_key")
  @@index([authoritativeRecordDeclarationId, status], map: "TokenRepresentation_authority_status_idx")
  @@index([tokenId])
}

// PR-15 connector and custody assignment. A binding names who controls signing and which certified
// connector performs the external action; it never stores a private key or makes the token legal title.
model TokenConnectorBinding {
  id                                  String                 @id
  tokenRepresentationId               String
  tokenRepresentation                 TokenRepresentation    @relation(fields: [tokenRepresentationId], references: [id], onDelete: Restrict)
  version                             Int
  connectorRegistrationId             String
  connectorRegistration               ConnectorRegistration  @relation(fields: [connectorRegistrationId], references: [id], onDelete: Restrict)
  connectorCertificationId            String
  connectorCertification              ConnectorCertification @relation(fields: [connectorCertificationId], references: [id], onDelete: Restrict)
  connectorProfileRef                 String
  custodyInstitutionId                String
  custodyInstitution                  Institution            @relation("TokenCustodyInstitution", fields: [custodyInstitutionId], references: [id], onDelete: Restrict)
  custodyModel                        String // EXTERNAL_CUSTODIAN | INSTITUTION_CONTROLLED | MPC_PROVIDER
  signingKeyReference                 String
  signingPolicyDigest                 String
  supportedActionTypes                Json // MINT | TRANSFER | ANCHOR | AMORTISE_BURN | CLOSE_BURN; payment uses a separate connector
  custodyEvidenceObjectId             String
  custodyEvidenceObject               EvidenceObject         @relation("TokenCustodyEvidence", fields: [custodyEvidenceObjectId], references: [id], onDelete: Restrict)
  custodyEvidenceDigest               String
  legalFinalityEvidenceObjectId        String
  legalFinalityEvidenceObject          EvidenceObject         @relation("TokenLegalFinalityEvidence", fields: [legalFinalityEvidenceObjectId], references: [id], onDelete: Restrict)
  legalFinalityEvidenceDigest          String
  operatingAcceptanceEvidenceObjectId  String
  operatingAcceptanceEvidenceObject    EvidenceObject         @relation("TokenOperatingAcceptanceEvidence", fields: [operatingAcceptanceEvidenceObjectId], references: [id], onDelete: Restrict)
  operatingAcceptanceEvidenceDigest    String
  status                              String                 @default("PROPOSED") // PROPOSED | ACTIVE | REJECTED | SUSPENDED | REVOKED | EXPIRED
  proposalDigest                      String
  proposedByUserId                    String
  proposedByMandateId                 String
  proposalStepUpId                    String
  proposedAt                          DateTime               @default(now())
  reviewedByUserId                    String?
  reviewedByMandateId                 String?
  reviewStepUpId                      String?
  reviewReason                        String?
  reviewedAt                          DateTime?
  effectiveAt                         DateTime?
  expiresAt                           DateTime?
  suspendedByUserId                   String?
  suspensionReason                    String?
  suspendedAt                         DateTime?
  createdAt                           DateTime               @default(now())
  updatedAt                           DateTime               @default(now()) @updatedAt
  actions                             TokenAction[]

  @@unique([tokenRepresentationId, version], map: "TokenConnectorBinding_representation_version_key")
  @@unique([tokenRepresentationId, proposalDigest], map: "TokenConnectorBinding_representation_proposal_key")
  @@index([tokenRepresentationId, status, effectiveAt], map: "TokenConnectorBinding_representation_status_idx")
  @@index([connectorRegistrationId, status], map: "TokenConnectorBinding_connector_status_idx")
  @@index([connectorCertificationId])
  @@index([custodyInstitutionId, status])
}

model TokenAction {
  id                    String              @id
  tokenRepresentationId String
  tokenRepresentation   TokenRepresentation @relation(fields: [tokenRepresentationId], references: [id], onDelete: Restrict)
  externalInstructionId String              @unique
  externalInstruction   ExternalInstruction @relation(fields: [externalInstructionId], references: [id], onDelete: Restrict)
  actionType            String // MINT | TRANSFER | PAYMENT | ANCHOR | AMORTISE_BURN | CLOSE_BURN
  sequence              Int
  executionMode         String              @default("OBSERVE_ONLY")
  state                 String              @default("PREPARED") // PREPARED | OBSERVED | RECONCILED | BREAK_OPEN | CANCELLED
  expected              Json
  expectedDigest        String
  idempotencyKey        String
  requestDigest         String
  createdByUserId       String
  createdByMandateId    String
  stepUpEvidenceId      String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @default(now()) @updatedAt
  connectorBindingId    String?
  connectorBinding      TokenConnectorBinding? @relation(fields: [connectorBindingId], references: [id], onDelete: Restrict)

  @@unique([tokenRepresentationId, idempotencyKey], map: "TokenAction_representation_idempotency_key")
  @@unique([tokenRepresentationId, sequence], map: "TokenAction_representation_sequence_key")
  @@index([tokenRepresentationId, state, sequence], map: "TokenAction_representation_state_sequence_idx")
  @@index([connectorBindingId, state], map: "TokenAction_connector_state_idx")
}

model TokenReconciliationSnapshot {
  id                        String                     @id
  tokenRepresentationId     String
  tokenRepresentation       TokenRepresentation        @relation(fields: [tokenRepresentationId], references: [id], onDelete: Restrict)
  version                   Int
  idempotencyKey            String
  requestDigest             String
  tokenSupplyMinor          String
  tokenHoldings             Json
  tokenHoldingsDigest       String
  economicInterests         Json
  economicInterestDigest    String
  authoritativeRecord       Json
  authoritativeRecordDigest String
  evidenceObjectId          String
  evidenceObject            EvidenceObject             @relation(fields: [evidenceObjectId], references: [id], onDelete: Restrict)
  sourceAsOfAt              DateTime
  comparison                Json
  comparisonDigest          String
  reconciliationState       String // MATCHED | BREAK_OPEN
  recordedByUserId          String
  recordedByMandateId       String
  stepUpEvidenceId          String
  createdAt                 DateTime                   @default(now())
  breaks                    TokenReconciliationBreak[]

  @@unique([tokenRepresentationId, version], map: "TokenReconciliationSnapshot_representation_version_key")
  @@unique([tokenRepresentationId, idempotencyKey], map: "TokenReconciliationSnapshot_representation_idempotency_key")
  @@index([tokenRepresentationId, reconciliationState, createdAt], map: "TokenReconciliationSnapshot_state_created_idx")
  @@index([evidenceObjectId])
}

model TokenReconciliationBreak {
  id                       String                      @id
  tokenRepresentationId    String
  tokenRepresentation      TokenRepresentation         @relation(fields: [tokenRepresentationId], references: [id], onDelete: Restrict)
  reconciliationSnapshotId String
  reconciliationSnapshot   TokenReconciliationSnapshot @relation(fields: [reconciliationSnapshotId], references: [id], onDelete: Restrict)
  breakCode                String
  severity                 String
  expected                 Json
  observed                 Json
  expectedDigest           String
  observedDigest           String
  blockedCapabilities      Json
  status                   String                      @default("OPEN") // OPEN | RESOLVED
  ownerInstitutionId       String
  ownerInstitution         Institution                 @relation(fields: [ownerInstitutionId], references: [id], onDelete: Restrict)
  dueAt                    DateTime
  openedByUserId           String
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @default(now()) @updatedAt

  @@unique([reconciliationSnapshotId, breakCode], map: "TokenReconciliationBreak_snapshot_code_key")
  @@index([tokenRepresentationId, status, severity], map: "TokenReconciliationBreak_representation_status_idx")
  @@index([ownerInstitutionId, status, dueAt], map: "TokenReconciliationBreak_owner_status_due_idx")
}

model AuthoritativeRecordSnapshot {
  id                               String                         @id
  authoritativeRecordDeclarationId String
  authoritativeRecordDeclaration   AuthoritativeRecordDeclaration @relation(fields: [authoritativeRecordDeclarationId], references: [id], onDelete: Restrict)
  settlementSagaId                 String
  settlementSaga                   SettlementSaga                 @relation(fields: [settlementSagaId], references: [id], onDelete: Restrict)
  snapshotKind                     String // BEFORE | AFTER
  recordReference                  String
  payloadDigest                    String
  evidenceObjectId                 String
  evidenceObject                   EvidenceObject                 @relation(fields: [evidenceObjectId], references: [id], onDelete: Restrict)
  sourceAsOfAt                     DateTime
  recordedByUserId                 String
  createdAt                        DateTime                       @default(now())

  @@unique([settlementSagaId, snapshotKind])
  @@index([authoritativeRecordDeclarationId, sourceAsOfAt])
  @@index([evidenceObjectId])
}

model ReconciliationBreak {
  id                 String          @id
  transactionCaseId  String
  transactionCase    TransactionCase @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  settlementSagaId   String
  settlementSaga     SettlementSaga  @relation(fields: [settlementSagaId], references: [id], onDelete: Restrict)
  settlementLegId    String?
  settlementLeg      SettlementLeg?  @relation(fields: [settlementLegId], references: [id], onDelete: Restrict)
  breakCode          String
  severity           String
  expected           Json
  observed           Json
  expectedDigest     String
  observedDigest     String
  blockedCapabilities Json
  status             String          @default("OPEN") // OPEN | REPAIR_PROPOSED | REPAIR_IN_PROGRESS | RESOLVED
  ownerInstitutionId String
  ownerInstitution   Institution     @relation("ReconciliationBreakOwnerInstitution", fields: [ownerInstitutionId], references: [id], onDelete: Restrict)
  dueAt              DateTime
  openedByUserId     String
  resolutionEvidenceRef    String?
  resolutionEvidenceDigest String?
  resolutionReason         String?
  resolvedByUserId         String?
  independentlyClosedByUserId String?
  resolvedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt
  repairActions      SagaRepairAction[]

  @@index([transactionCaseId, status, severity])
  @@index([settlementSagaId, status])
  @@index([ownerInstitutionId, status, dueAt])
}

model SagaRepairAction {
  id                     String                 @id
  reconciliationBreakId  String
  reconciliationBreak    ReconciliationBreak    @relation(fields: [reconciliationBreakId], references: [id], onDelete: Restrict)
  idempotencyKey         String
  requestDigest          String
  actionType             String // APPEND_CORRECTED_OBSERVATION
  replacementObservation Json
  reason                 String
  authorityEvidenceRef   String
  status                 String                 @default("PROPOSED") // PROPOSED | APPROVED | REJECTED | APPLIED
  proposedByUserId       String
  proposedByMandateId    String
  proposalStepUpId       String
  reviewedByUserId       String?
  reviewedByMandateId    String?
  reviewStepUpId         String?
  reviewReason           String?
  reviewIdempotencyKey   String?
  reviewRequestDigest    String?
  appliedObservationId   String?                @unique
  appliedObservation     SagaLegObservation?    @relation("AppliedRepairObservation", fields: [appliedObservationId], references: [id], onDelete: Restrict)
  proposedAt             DateTime               @default(now())
  reviewedAt             DateTime?
  appliedAt              DateTime?

  @@unique([reconciliationBreakId, idempotencyKey])
  @@index([reconciliationBreakId, status, proposedAt])
}

model MigrationReceipt {
  id                  String            @id
  batchId             String
  migrationName       String
  sourceSystem        String
  sourceHighWaterMark String?
  sourceCount         Int
  targetCount         Int
  sourceDigest        String?
  targetDigest        String?
  errorObjectRef      String?
  operatorRef         String
  reviewerRef         String?
  status              String            @default("STARTED") // STARTED | VERIFIED | FAILED | ROLLED_BACK
  institutionId       String?
  transactionCaseId   String?
  startedAt           DateTime          @default(now())
  completedAt         DateTime?
  receiptDigest       String?
  createdAt           DateTime          @default(now())
  roomImport          LegacyRoomImport?

  @@unique([batchId, migrationName])
  @@index([status, startedAt])
  @@index([institutionId])
  @@index([transactionCaseId])
}

// ───────────────── controlled-pilot and production readiness (PR-12) ─────────────────
// Readiness decisions are durable and independently reviewable. External evidence requirements
// cannot be closed by a synthetic fixture; the accepted decision is snapshotted into a signed,
// expiring deployment activation record before a controlled-live/production process may boot.
model OperationalReadinessGate {
  id                       String                       @id
  environment              String
  scopeType                String                       // GLOBAL | ROUTE_FUNCTION | CONNECTOR | CUSTOMER_COHORT
  scopeRef                 String?
  scopeKey                 String
  gateCode                 String
  requirementVersion       Int                          @default(1)
  title                    String
  requirement              String
  evidenceClassRequired    String                       // INTERNAL | EXTERNAL
  status                   String                       @default("OPEN") // OPEN | SUBMITTED | ACCEPTED | REJECTED | EXPIRED | REVOKED
  ownerUserId              String
  proposedByUserId         String
  proposalStepUpId         String
  proposalDigest           String                       @unique
  currentEvidenceRef       String?
  currentEvidenceDigest    String?
  currentDecisionId        String?                      @unique
  currentDecision          OperationalReadinessDecision? @relation("CurrentReadinessDecision", fields: [currentDecisionId], references: [id], onDelete: Restrict)
  acceptedAt               DateTime?
  expiresAt                DateTime?
  revokedAt                DateTime?
  supersedesId             String?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @default(now()) @updatedAt
  decisions                OperationalReadinessDecision[] @relation("ReadinessGateDecisions")
  activationBindings       DeploymentActivationGate[]

  @@unique([environment, scopeKey, gateCode, requirementVersion], map: "OperationalReadinessGate_scope_code_version_key")
  @@index([environment, status, expiresAt], map: "OperationalReadinessGate_environment_status_expiry_idx")
  @@index([scopeType, scopeRef, gateCode], map: "OperationalReadinessGate_scope_code_idx")
  @@index([ownerUserId, status], map: "OperationalReadinessGate_owner_status_idx")
}

model OperationalReadinessDecision {
  id                    String                   @id
  readinessGateId       String
  readinessGate         OperationalReadinessGate @relation("ReadinessGateDecisions", fields: [readinessGateId], references: [id], onDelete: Restrict)
  currentForGate        OperationalReadinessGate? @relation("CurrentReadinessDecision")
  version               Int
  decision              String                   // ACCEPT | REJECT | REVOKE
  evidenceClass         String                   // INTERNAL | EXTERNAL
  evidenceRef           String
  evidenceDigest        String
  reason                String
  decidedByUserId       String
  decisionStepUpId      String
  decisionDigest        String                   @unique
  validFrom              DateTime
  expiresAt             DateTime
  createdAt             DateTime                 @default(now())
  activationBindings    DeploymentActivationGate[]

  @@unique([readinessGateId, version], map: "OperationalReadinessDecision_gate_version_key")
  @@index([readinessGateId, decision, expiresAt], map: "OperationalReadinessDecision_gate_decision_expiry_idx")
  @@index([decidedByUserId, createdAt], map: "OperationalReadinessDecision_actor_created_idx")
}

model DeploymentActivation {
  id                  String                     @id
  manifestId          String                     @unique
  environment         String
  operatingMode       String                     // CONTROLLED_LIVE | PRODUCTION
  buildCommit         String
  status              String                     @default("DRAFT") // DRAFT | APPROVED | REVOKED | EXPIRED
  manifest            Json
  manifestDigest      String                     @unique
  signatureAlgorithm  String                     @default("ED25519")
  signingKeyId        String
  signature           String
  proposedByUserId    String
  proposalStepUpId    String
  approvedByUserId    String?
  approvalStepUpId    String?
  approvalReason      String?
  approvalDigest      String?                    @unique
  approvedAt          DateTime?
  expiresAt           DateTime
  revokedByUserId     String?
  revocationStepUpId  String?
  revocationReason    String?
  revokedAt           DateTime?
  createdAt           DateTime                   @default(now())
  gateBindings        DeploymentActivationGate[]

  @@index([environment, operatingMode, status, expiresAt], map: "DeploymentActivation_environment_mode_status_idx")
  @@index([buildCommit, status], map: "DeploymentActivation_build_status_idx")
}

model DeploymentActivationGate {
  deploymentActivationId String
  deploymentActivation   DeploymentActivation         @relation(fields: [deploymentActivationId], references: [id], onDelete: Restrict)
  readinessGateId        String
  readinessGate          OperationalReadinessGate      @relation(fields: [readinessGateId], references: [id], onDelete: Restrict)
  readinessDecisionId    String
  readinessDecision      OperationalReadinessDecision  @relation(fields: [readinessDecisionId], references: [id], onDelete: Restrict)
  gateCode               String
  scopeKey               String
  evidenceDigest         String
  boundAt                DateTime                      @default(now())

  @@id([deploymentActivationId, readinessGateId])
  @@unique([deploymentActivationId, gateCode], map: "DeploymentActivationGate_activation_code_key")
  @@index([readinessGateId, boundAt], map: "DeploymentActivationGate_gate_bound_idx")
  @@index([readinessDecisionId], map: "DeploymentActivationGate_decision_idx")
}

// ───────────────── permissioned primary commercial venue (PR-13) ─────────────────
// Commercial interaction is case-, institution- and function-scoped. These records do not execute,
// settle, issue, transfer ownership or become an order book merely because they exist.
model CommercialOpportunity {
  id                     String          @id
  transactionCaseId      String
  transactionCase        TransactionCase @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  ownerInstitutionId     String
  ownerInstitution       Institution     @relation("CommercialOpportunityOwnerInstitution", fields: [ownerInstitutionId], references: [id], onDelete: Restrict)
  opportunityReference   String
  status                 String          @default("DRAFT") // DRAFT | PUBLISHED | PAUSED | WITHDRAWN | CLOSED
  audienceMode           String          @default("NAMED_INSTITUTIONS")
  currentTermVersion     Int?
  aggregateVersion       Int             @default(1)
  opensAt                DateTime?
  closesAt               DateTime?
  creationIdempotencyKey String
  creationRequestDigest  String
  createdByUserId        String
  createdByMandateId     String
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt
  terms                  CommercialTermVersion[]
  audienceGrants         CommercialAudienceGrant[]
  changes                CommercialOpportunityChange[]
  interests              CommercialInterestIndication[]
  rfqs                   CommercialRfq[]
  threads                CommercialNegotiationThread[]
  allocations            CommercialAllocation[]
  caseHandoffs           CommercialCaseHandoff[]

  @@unique([transactionCaseId, opportunityReference])
  @@unique([ownerInstitutionId, creationIdempotencyKey])
  @@index([ownerInstitutionId, status, createdAt])
  @@index([transactionCaseId, status])
}

model CommercialTermVersion {
  id                       String                @id
  commercialOpportunityId  String
  commercialOpportunity    CommercialOpportunity @relation(fields: [commercialOpportunityId], references: [id], onDelete: Restrict)
  version                  Int
  currency                 String
  amountUnits              String
  amountScale              Int
  minimumParticipationUnits String
  maximumParticipationUnits String?
  pricingType              String
  pricingValue             String
  commercialTerms          Json
  termSheetEvidenceObjectId String?
  validFrom                DateTime
  expiresAt                DateTime
  termDigest               String
  reason                   String
  createdByUserId          String
  createdByMandateId       String
  stepUpEvidenceId         String
  createdAt                DateTime              @default(now())
  interests                CommercialInterestIndication[]
  rfqs                     CommercialRfq[]
  allocations              CommercialAllocation[]
  caseHandoffs              CommercialCaseHandoff[]

  @@unique([commercialOpportunityId, version])
  @@unique([commercialOpportunityId, termDigest])
  @@index([commercialOpportunityId, expiresAt])
}

model CommercialAudienceGrant {
  id                      String                @id
  commercialOpportunityId String
  commercialOpportunity   CommercialOpportunity @relation(fields: [commercialOpportunityId], references: [id], onDelete: Restrict)
  institutionId           String
  institution             Institution           @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  status                  String                @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
  purpose                 String
  conflictDisclosure      Json
  effectiveAt             DateTime
  expiresAt               DateTime
  invitationDigest        String                @unique
  invitedByUserId         String
  invitedByMandateId      String
  stepUpEvidenceId        String
  revokedByUserId         String?
  revocationReason        String?
  revokedAt               DateTime?
  createdAt               DateTime              @default(now())
  caseHandoffs             CommercialCaseHandoff[]

  @@unique([commercialOpportunityId, institutionId])
  @@index([institutionId, status, expiresAt])
}

model CommercialOpportunityChange {
  id                      String                @id
  commercialOpportunityId String
  commercialOpportunity   CommercialOpportunity @relation(fields: [commercialOpportunityId], references: [id], onDelete: Restrict)
  action                  String // PUBLISH | PAUSE | RESUME | WITHDRAW | CLOSE
  expectedVersion         Int
  fromStatus              String
  toStatus                String
  reason                  String
  proposalDigest          String
  status                  String                @default("PENDING") // PENDING | APPROVED | REJECTED | SUPERSEDED
  proposedByUserId        String
  proposedByMandateId     String
  proposalStepUpId        String
  reviewedByUserId        String?
  reviewedByMandateId     String?
  reviewStepUpId          String?
  reviewReason            String?
  proposedAt              DateTime              @default(now())
  reviewedAt              DateTime?
  appliedAt               DateTime?

  @@unique([commercialOpportunityId, proposalDigest])
  @@index([commercialOpportunityId, status, proposedAt])
}

model CommercialInterestIndication {
  id                      String                @id
  commercialOpportunityId String
  commercialOpportunity   CommercialOpportunity @relation(fields: [commercialOpportunityId], references: [id], onDelete: Restrict)
  institutionId           String
  institution             Institution           @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  termVersionId           String
  termVersion             CommercialTermVersion @relation(fields: [termVersionId], references: [id], onDelete: Restrict)
  currency                String
  amountUnits             String
  amountScale             Int
  status                  String                @default("SUBMITTED") // SUBMITTED | WITHDRAWN | CONVERTED | EXPIRED
  qualifications          Json
  idempotencyKey          String
  requestDigest           String
  submittedByUserId       String
  submittedByMandateId    String
  submissionStepUpId      String
  withdrawnByUserId       String?
  withdrawalStepUpId      String?
  withdrawalReason        String?
  withdrawnAt             DateTime?
  expiresAt               DateTime
  createdAt               DateTime              @default(now())

  @@unique([commercialOpportunityId, institutionId, idempotencyKey])
  @@index([commercialOpportunityId, status, createdAt])
  @@index([institutionId, status, createdAt])
}

model CommercialRfq {
  id                       String                @id
  commercialOpportunityId  String
  commercialOpportunity    CommercialOpportunity @relation(fields: [commercialOpportunityId], references: [id], onDelete: Restrict)
  requesterInstitutionId   String
  requesterInstitution     Institution           @relation("CommercialRfqRequesterInstitution", fields: [requesterInstitutionId], references: [id], onDelete: Restrict)
  termVersionId            String
  termVersion              CommercialTermVersion @relation(fields: [termVersionId], references: [id], onDelete: Restrict)
  currency                 String
  amountUnits              String
  amountScale              Int
  requestedTerms           Json
  requestedTermsDigest     String
  status                   String                @default("OPEN") // OPEN | RESPONDED | DECLINED | WITHDRAWN | CLOSED | EXPIRED
  responseTerms            Json?
  responseTermsDigest      String?
  responseReason           String?
  idempotencyKey           String
  requestDigest            String
  requestedByUserId        String
  requestedByMandateId     String
  requestStepUpId          String
  respondedByUserId        String?
  respondedByMandateId     String?
  responseStepUpId         String?
  respondedAt              DateTime?
  expiresAt                DateTime
  createdAt                DateTime              @default(now())
  threads                  CommercialNegotiationThread[]

  @@unique([commercialOpportunityId, requesterInstitutionId, idempotencyKey])
  @@index([commercialOpportunityId, status, createdAt])
  @@index([requesterInstitutionId, status, createdAt])
}

model CommercialNegotiationThread {
  id                       String                @id
  commercialOpportunityId  String
  commercialOpportunity    CommercialOpportunity @relation(fields: [commercialOpportunityId], references: [id], onDelete: Restrict)
  commercialRfqId          String?
  commercialRfq            CommercialRfq?        @relation(fields: [commercialRfqId], references: [id], onDelete: Restrict)
  ownerInstitutionId       String
  ownerInstitution         Institution           @relation("CommercialThreadOwnerInstitution", fields: [ownerInstitutionId], references: [id], onDelete: Restrict)
  counterpartyInstitutionId String
  counterpartyInstitution  Institution           @relation("CommercialThreadCounterpartyInstitution", fields: [counterpartyInstitutionId], references: [id], onDelete: Restrict)
  status                   String                @default("OPEN") // OPEN | ACCEPTED | REJECTED | WITHDRAWN | CLOSED
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @default(now()) @updatedAt
  messages                 CommercialNegotiationMessage[]

  @@unique([commercialOpportunityId, counterpartyInstitutionId, commercialRfqId])
  @@index([ownerInstitutionId, status])
  @@index([counterpartyInstitutionId, status])
}

model CommercialNegotiationMessage {
  id                    String                      @id
  negotiationThreadId   String
  negotiationThread     CommercialNegotiationThread @relation(fields: [negotiationThreadId], references: [id], onDelete: Restrict)
  senderInstitutionId   String
  senderInstitution     Institution                 @relation(fields: [senderInstitutionId], references: [id], onDelete: Restrict)
  messageKind           String // PROPOSAL | COUNTER | COMMENT | WITHDRAWAL
  body                  String
  termSnapshot          Json?
  termSnapshotDigest    String?
  previousMessageId     String?
  idempotencyKey        String
  requestDigest         String
  sentByUserId          String
  sentByMandateId       String
  stepUpEvidenceId      String
  occurredAt            DateTime                    @default(now())

  @@unique([negotiationThreadId, idempotencyKey])
  @@index([negotiationThreadId, occurredAt])
}

model CommercialAllocation {
  id                      String                @id
  commercialOpportunityId String
  commercialOpportunity   CommercialOpportunity @relation(fields: [commercialOpportunityId], references: [id], onDelete: Restrict)
  allocationReference     String
  offereeInstitutionId    String
  offereeInstitution      Institution           @relation(fields: [offereeInstitutionId], references: [id], onDelete: Restrict)
  termVersionId           String
  termVersion             CommercialTermVersion @relation(fields: [termVersionId], references: [id], onDelete: Restrict)
  basisType               String // INTEREST | RFQ | NEGOTIATION
  basisId                 String
  currency                String
  amountUnits             String
  amountScale             Int
  status                  String                @default("PROPOSED") // PROPOSED | OFFERED | REJECTED_INTERNAL | ACCEPTED | DECLINED | WITHDRAWN | EXPIRED
  idempotencyKey          String
  proposalDigest          String
  proposedByUserId        String
  proposedByMandateId     String
  proposalStepUpId        String
  reviewedByUserId        String?
  reviewedByMandateId     String?
  reviewStepUpId          String?
  reviewReason            String?
  reviewedAt              DateTime?
  respondedByUserId       String?
  respondedByMandateId    String?
  responseStepUpId        String?
  responseReason          String?
  respondedAt             DateTime?
  expiresAt               DateTime
  createdAt               DateTime              @default(now())
  caseHandoff             CommercialCaseHandoff?

  @@unique([commercialOpportunityId, allocationReference])
  @@unique([commercialOpportunityId, idempotencyKey])
  @@index([commercialOpportunityId, status, createdAt])
  @@index([offereeInstitutionId, status, createdAt])
}

// AR-26: immutable commercial-to-case handoff. The opportunity already belongs to a transaction
// case; this receipt binds an accepted allocation to that case and proposes, but never accepts, the
// counterparty's case role. It does not execute, settle, issue or change an authoritative record.
model CommercialCaseHandoff {
  id                        String                 @id
  commercialOpportunityId   String
  commercialOpportunity     CommercialOpportunity @relation(fields: [commercialOpportunityId], references: [id], onDelete: Restrict, map: "CommercialCaseHandoff_opportunity_fkey")
  commercialAllocationId    String                 @unique(map: "CommercialCaseHandoff_commercialAllocationId_key")
  commercialAllocation      CommercialAllocation  @relation(fields: [commercialAllocationId], references: [id], onDelete: Restrict, map: "CommercialCaseHandoff_allocation_fkey")
  transactionCaseId         String
  transactionCase           TransactionCase        @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict, map: "CommercialCaseHandoff_case_fkey")
  termVersionId             String
  termVersion               CommercialTermVersion  @relation(fields: [termVersionId], references: [id], onDelete: Restrict, map: "CommercialCaseHandoff_term_fkey")
  audienceGrantId           String
  audienceGrant             CommercialAudienceGrant @relation(fields: [audienceGrantId], references: [id], onDelete: Restrict, map: "CommercialCaseHandoff_audience_grant_fkey")
  casePartyId               String
  caseParty                 CaseParty               @relation(fields: [casePartyId], references: [id], onDelete: Restrict, map: "CommercialCaseHandoff_party_fkey")
  ownerInstitutionId        String
  ownerInstitution          Institution             @relation("CommercialHandoffOwnerInstitution", fields: [ownerInstitutionId], references: [id], onDelete: Restrict, map: "CommercialCaseHandoff_owner_fkey")
  counterpartyInstitutionId String
  counterpartyInstitution   Institution             @relation("CommercialHandoffCounterpartyInstitution", fields: [counterpartyInstitutionId], references: [id], onDelete: Restrict, map: "CommercialCaseHandoff_counterparty_fkey")
  counterpartyPartyRole     String
  status                    String                  @default("HANDOFF_RECORDED")
  termDigest                String
  audienceGrantDigest       String
  allocationDigest          String
  eligibilityDecisionCode   String
  eligibilityCheckedAt      DateTime
  handoffDigest             String                  @unique(map: "CommercialCaseHandoff_handoffDigest_key")
  idempotencyKey            String
  requestDigest             String
  createdByUserId           String
  createdByMandateId        String
  stepUpEvidenceId          String
  createdAt                 DateTime                @default(now())

  @@unique([commercialOpportunityId, idempotencyKey], map: "CommercialCaseHandoff_opportunity_idempotency_key")
  @@index([transactionCaseId, status, createdAt], map: "CommercialCaseHandoff_case_status_created_idx")
  @@index([counterpartyInstitutionId, status, createdAt], map: "CommercialCaseHandoff_counterparty_status_created_idx")
}

// ───────────────── conventional secondary DA/PTC replay (PR-14) ─────────────────
// Retained observation-only dossiers. These records cannot dispatch cash, transfer title, update a
// register or infer ownership from a Rail projection.
model SecondaryTransfer {
  id                        String          @id
  transactionCaseId         String          @unique
  transactionCase           TransactionCase @relation(fields: [transactionCaseId], references: [id], onDelete: Restrict)
  transactionRoute          String          // DA | PTC
  routePackRef              String
  routePackVersion          String
  executionMode             String          @default("OBSERVE_ONLY")
  transferReference         String
  instrumentReference       String
  instrumentDigest          String
  sellerInstitutionId       String
  sellerInstitution         Institution     @relation("SecondaryTransferSellerInstitution", fields: [sellerInstitutionId], references: [id], onDelete: Restrict)
  buyerInstitutionId        String
  buyerInstitution          Institution     @relation("SecondaryTransferBuyerInstitution", fields: [buyerInstitutionId], references: [id], onDelete: Restrict)
  trusteeInstitutionId      String?
  trusteeInstitution        Institution?    @relation("SecondaryTransferTrusteeInstitution", fields: [trusteeInstitutionId], references: [id], onDelete: Restrict)
  recordkeeperInstitutionId String
  recordkeeperInstitution   Institution     @relation("SecondaryTransferRecordkeeperInstitution", fields: [recordkeeperInstitutionId], references: [id], onDelete: Restrict)
  quantityUnits             String
  quantityScale             Int
  considerationCurrency     String
  considerationMinorUnits   String
  considerationScale        Int
  status                    String          @default("COLLECTING") // COLLECTING | PROPOSED | REJECTED | RECONCILED | BREAK_OPEN
  aggregateVersion          Int             @default(1)
  creationIdempotencyKey    String
  creationRequestDigest     String
  proposedByUserId          String?
  proposedByMandateId       String?
  proposalStepUpId          String?
  proposalDigest            String?
  proposedAt                DateTime?
  reviewedByUserId          String?
  reviewedByMandateId       String?
  reviewStepUpId            String?
  reviewReason              String?
  reviewedAt                DateTime?
  reconciledAt              DateTime?
  createdByUserId           String
  createdByMandateId        String
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @default(now()) @updatedAt
  evidence                  SecondaryTransferEvidence[]
  legs                      SecondaryTransferLeg[]
  breaks                    SecondaryTransferBreak[]

  @@unique([sellerInstitutionId, creationIdempotencyKey], map: "SecondaryTransfer_seller_creation_idem_key")
  @@unique([transactionCaseId, transferReference])
  @@index([sellerInstitutionId, status, createdAt])
  @@index([buyerInstitutionId, status, createdAt])
  @@index([transactionRoute, status, updatedAt])
}

model SecondaryTransferEvidence {
  id                    String            @id
  secondaryTransferId   String
  secondaryTransfer     SecondaryTransfer @relation(fields: [secondaryTransferId], references: [id], onDelete: Restrict)
  evidenceType          String
  version               Int
  providerInstitutionId String
  providerInstitution   Institution       @relation(fields: [providerInstitutionId], references: [id], onDelete: Restrict)
  evidenceObjectId      String
  evidenceObject        EvidenceObject    @relation(fields: [evidenceObjectId], references: [id], onDelete: Restrict)
  evidenceResult        String
  assertionDigest       String
  sourceAsOfAt          DateTime
  idempotencyKey        String
  requestDigest         String
  recordedByUserId      String
  recordedByMandateId   String
  stepUpEvidenceId      String
  createdAt             DateTime          @default(now())

  @@unique([secondaryTransferId, evidenceType, version], map: "SecondaryTransferEvidence_transfer_type_version_key")
  @@unique([secondaryTransferId, evidenceType, assertionDigest], map: "SecondaryTransferEvidence_transfer_type_assertion_key")
  @@unique([secondaryTransferId, idempotencyKey], map: "SecondaryTransferEvidence_transfer_idem_key")
  @@index([secondaryTransferId, evidenceType, createdAt], map: "SecondaryTransferEvidence_transfer_type_created_idx")
  @@index([evidenceObjectId])
}

model SecondaryTransferLeg {
  id                      String            @id
  secondaryTransferId     String
  secondaryTransfer       SecondaryTransfer @relation(fields: [secondaryTransferId], references: [id], onDelete: Restrict)
  legKey                  String
  legType                 String
  sequence                Int
  performerInstitutionId  String
  performerClass          String
  expectedEvidenceType    String
  expectedAssertionDigest String
  evidenceRecordId        String
  state                   String            @default("PLANNED") // PLANNED | MATCHED | BREAK_OPEN
  comparisonDigest        String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @default(now()) @updatedAt

  @@unique([secondaryTransferId, legKey])
  @@unique([secondaryTransferId, sequence])
  @@unique([secondaryTransferId, evidenceRecordId], map: "SecondaryTransferLeg_transfer_evidence_key")
  @@index([secondaryTransferId, state, sequence], map: "SecondaryTransferLeg_transfer_state_sequence_idx")
}

model SecondaryTransferBreak {
  id                    String            @id
  secondaryTransferId   String
  secondaryTransfer     SecondaryTransfer @relation(fields: [secondaryTransferId], references: [id], onDelete: Restrict)
  breakCode             String
  severity              String
  expectedDigest        String
  observedDigest        String
  blockedCapabilities   Json
  ownerInstitutionId    String
  ownerInstitution      Institution       @relation("SecondaryTransferBreakOwnerInstitution", fields: [ownerInstitutionId], references: [id], onDelete: Restrict)
  status                String            @default("OPEN") // OPEN | RESOLVED
  detail                Json
  openedByUserId        String
  repairs               SecondaryTransferRepair[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @default(now()) @updatedAt

  @@unique([secondaryTransferId, breakCode], map: "SecondaryTransferBreak_transfer_code_key")
  @@index([secondaryTransferId, status, severity], map: "SecondaryTransferBreak_transfer_status_severity_idx")
  @@index([ownerInstitutionId, status, createdAt])
}

model SecondaryTransferRepair {
  id                         String                 @id
  secondaryTransferBreakId   String
  secondaryTransferBreak     SecondaryTransferBreak @relation(fields: [secondaryTransferBreakId], references: [id], onDelete: Restrict)
  replacementEvidenceType    String
  providerInstitutionId      String
  providerInstitution        Institution            @relation("SecondaryTransferRepairProviderInstitution", fields: [providerInstitutionId], references: [id], onDelete: Restrict)
  evidenceObjectId           String
  evidenceObject             EvidenceObject         @relation(fields: [evidenceObjectId], references: [id], onDelete: Restrict)
  assertionDigest            String
  authorityEvidenceRef       String
  idempotencyKey             String
  requestDigest              String
  status                     String                 @default("PROPOSED") // PROPOSED | APPROVED | REJECTED
  proposedByUserId           String
  proposedByMandateId        String
  proposalStepUpId           String
  reviewedByUserId           String?
  reviewedByMandateId        String?
  reviewStepUpId             String?
  reviewReason               String?
  appliedEvidenceRecordId    String?                @unique
  proposedAt                 DateTime               @default(now())
  reviewedAt                 DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @default(now()) @updatedAt

  @@unique([secondaryTransferBreakId, idempotencyKey], map: "SecondaryTransferRepair_break_idem_key")
  @@index([secondaryTransferBreakId, status, createdAt], map: "SecondaryTransferRepair_break_status_created_idx")
  @@index([evidenceObjectId])
}

/// Append-only, hash-chained audit trail. Written via a single-writer/advisory-locked append so
/// concurrent writes can't fork the chain: hash = sha256(prevHash + canonical(record)). Distinct
/// actor namespaces (system:tokenco lifecycle vs system:tokenco-ops remediation). `detail` is redacted
/// (hashes/row-ids, never raw holder/pool/tape data). This is the durable replacement for the old
/// console-only audit() and the basis of the continuous-audit / governed-provenance story.
model AuditLog {
  id        String   @id
  seq       Int      @unique @default(autoincrement()) // strict append order (chain position)
  actor     String // system:tokenco | system:tokenco-ops | did:...
  event     String
  detail    Json
  noteId    String?
  governed  Boolean  @default(false)
  prevHash  String
  hash      String   @unique
  anchorRef String? // HCS anchor of governed events, once LIVE
  createdAt DateTime @default(now())

  @@index([event])
  @@index([noteId])
  @@index([createdAt])
}

// ───────────────── venue conduct, complaints and scale controls (PR-17) ─────────────────
// This is an internal evidence/control plane. A signal or alert is never an autonomous legal or
// regulatory conclusion, and an approved control action does not create participant authority.
model ConductPolicyRelease {
  id                     String   @id
  policyRef              String
  version                Int
  status                 String   @default("PROPOSED") // PROPOSED | APPROVED | REJECTED | SUPERSEDED
  effectiveFrom          DateTime
  expiresAt              DateTime
  prohibitedActionRules  Json
  fairAccessRules        Json
  communicationsRules    Json
  allocationRules        Json
  slaRules               Json
  policyDigest           String   @unique
  proposedByUserId       String
  proposalStepUpId       String
  reviewedByUserId       String?
  reviewStepUpId         String?
  reviewReason           String?
  reviewedAt             DateTime?
  createdAt              DateTime @default(now())
  signals                VenueConductSignal[]

  @@unique([policyRef, version])
  @@index([status, effectiveFrom, expiresAt])
}

model VenueConductSignal {
  id                     String   @id
  signalType             String // CONFLICT | RELATED_PARTY | FAIR_ACCESS | ALLOCATION | COMMUNICATION | PROHIBITED_ACTION
  transactionCaseId      String?
  commercialOpportunityId String?
  institutionId          String?
  route                  String?
  cohortRef              String?
  sourceEventRef         String
  sourceOccurredAt       DateTime
  sourceEvidenceRef      String
  sourceEvidenceDigest   String
  facts                  Json
  factsDigest            String
  policyReleaseId        String
  policyRelease          ConductPolicyRelease @relation(fields: [policyReleaseId], references: [id], onDelete: Restrict)
  evaluation             Json
  evaluationDigest       String
  result                 String   @default("REVIEW_REQUIRED") // REVIEW_REQUIRED | NO_ALERT
  idempotencyKey         String
  recordedByUserId       String
  stepUpEvidenceId       String
  createdAt              DateTime @default(now())
  alert                  VenueConductAlert?

  @@unique([sourceEventRef, idempotencyKey])
  @@unique([sourceEventRef, sourceEvidenceDigest, policyReleaseId], map: "VenueConductSignal_event_digest_policy_key")
  @@index([transactionCaseId, createdAt])
  @@index([commercialOpportunityId, createdAt])
  @@index([institutionId, createdAt])
  @@index([result, createdAt])
}

model VenueConductAlert {
  id                     String   @id
  signalId               String   @unique
  signal                 VenueConductSignal @relation(fields: [signalId], references: [id], onDelete: Restrict)
  alertCode              String
  severity               String
  status                 String   @default("OPEN") // OPEN | TRIAGED | INVESTIGATING | CLOSED_NO_FINDING | REMEDIATED | ESCALATED
  evidentialClassification String @default("REVIEW_REQUIRED")
  ownerUserId            String
  dueAt                  DateTime
  resolution             String?
  resolutionEvidenceRef  String?
  resolutionEvidenceDigest String?
  reviewedByUserId       String?
  reviewStepUpId         String?
  closedAt               DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt
  investigations         VenueConductInvestigation[]

  @@index([status, dueAt])
  @@index([ownerUserId, status, dueAt])
}

model VenueConductInvestigation {
  id                     String   @id
  alertId                String
  alert                  VenueConductAlert @relation(fields: [alertId], references: [id], onDelete: Restrict)
  complaintId            String?
  complaint              VenueComplaint? @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  status                 String   @default("OPEN") // OPEN | ON_HOLD | CONCLUDED | CANCELLED
  legalHold              Boolean  @default(false)
  scope                   Json
  evidenceRefs            Json
  assigneeUserId          String
  dueAt                   DateTime
  conclusion              String?
  conclusionClass         String? // NO_FINDING | CONTROL_FAILURE | REFERRED; not a legal conclusion
  proposedByUserId        String
  lastChangedByUserId     String
  stepUpEvidenceId        String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt

  @@index([alertId, status])
  @@index([complaintId, status])
  @@index([assigneeUserId, status, dueAt])
}

model VenueComplaint {
  id                     String   @id
  complaintRef           String   @unique
  complainantInstitutionId String?
  transactionCaseId      String?
  commercialOpportunityId String?
  category               String
  summary                String
  evidenceRefs           Json
  status                 String   @default("OPEN") // OPEN | ACKNOWLEDGED | INVESTIGATING | RESOLVED | REJECTED | WITHDRAWN
  ownerUserId            String
  dueAt                  DateTime
  idempotencyKey         String   @unique
  requestDigest          String   @unique
  recordedByUserId       String
  stepUpEvidenceId       String
  resolution             String?
  resolutionEvidenceRef  String?
  resolutionEvidenceDigest String?
  resolvedByUserId       String?
  resolvedAt             DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt
  investigations         VenueConductInvestigation[]
  corrections            VenueCorrection[]

  @@index([status, dueAt])
  @@index([complainantInstitutionId, status, createdAt])
}

model VenueCorrection {
