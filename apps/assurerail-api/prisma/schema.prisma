  complaintId            String?
  complaint              VenueComplaint? @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  targetType             String
  targetRef              String
  reason                 String
  priorDigest            String
  correctedDigest        String
  correctionEvidenceRef  String
  status                 String   @default("PROPOSED") // PROPOSED | APPROVED | REJECTED | APPLIED_EXTERNALLY
