# AssureRail web (apps/assurerail) — PUBLIC client config. Copy to .env.local and fill in.
# These values are public (inlined into the client bundle); they live in .env.local (gitignored) only
# because gitleaks flags the AIzaSy apiKey format — same pattern as AssureLocker's apps/web.
# From: Firebase console → Project settings → General → Your apps → Web app → Config.
NEXT_PUBLIC_FIREBASE_API_KEY=                       # AIzaSy… (fill from Firebase console)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=assurerail.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=assurerail
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=assurerail.firebasestorage.app
NEXT_PUBLIC_FIREBASE_SENDER_ID=668261348718
NEXT_PUBLIC_FIREBASE_APP_ID=1:668261348718:web:4b9ff814c009c6a83dfd7f

# reCAPTCHA Enterprise site key (public).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=REDACTED_PUBLIC_SITE_KEY

# Venue API origin (its own deploy). Prod: https://api.assurerail.com
NEXT_PUBLIC_ASSURERAIL_VENUE_URL=http://localhost:3006

# Build-time visibility controls only. They do not grant API authority or activate a transaction.
NEXT_PUBLIC_ASSURERAIL_CUSTOMER_WORKSPACE_V1=off # off | shadow
NEXT_PUBLIC_ASSURERAIL_CUSTOMER_OPERATIONS_V1=off # off | shadow
NEXT_PUBLIC_ASSURERAIL_HOSTED_ALPHA_V1=off # off | shadow
NEXT_PUBLIC_ASSURERAIL_INSTITUTIONAL_PRODUCT_V1=off # off | shadow
NEXT_PUBLIC_ASSURERAIL_DA_PRODUCT_V1=off # off | shadow
NEXT_PUBLIC_ASSURERAIL_PTC_PRODUCT_V1=off # off | shadow
NEXT_PUBLIC_ASSURERAIL_LIFECYCLE_PRODUCT_V1=off # off | shadow
NEXT_PUBLIC_ASSURERAIL_PRIMARY_VENUE_PRODUCT_V1=off # off | shadow
NEXT_PUBLIC_ASSURERAIL_SECONDARY_PRODUCT_V1=off # off | shadow
NEXT_PUBLIC_ASSURERAIL_TOKENISED_PRODUCT_V1=off # off | shadow
NEXT_PUBLIC_ASSURERAIL_ENTERPRISE_INTEGRATION_V1=off # off | shadow
NEXT_PUBLIC_ASSURERAIL_PRODUCTION_SCALE_V1=off # off | shadow
NEXT_PUBLIC_ASSURERAIL_GUIDED_JOURNEY_V1=off # off | shadow
NEXT_PUBLIC_ASSURERAIL_SANDBOX_V1=off # off | shadow
