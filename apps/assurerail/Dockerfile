# AssureRail web — standalone-repository Next.js build.
# Build context must be the repository root.

# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS base
WORKDIR /repo

FROM base AS installer
COPY package.json package-lock.json ./
COPY apps/assurerail/package.json ./apps/assurerail/package.json
COPY apps/assurerail-api/package.json ./apps/assurerail-api/package.json
RUN npm ci
COPY apps/assurerail ./apps/assurerail

ARG NEXT_PUBLIC_ASSURERAIL_VENUE_URL="http://localhost:3006"
ARG NEXT_PUBLIC_FIREBASE_API_KEY=""
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="assurerail.firebaseapp.com"
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID="assurerail"
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="assurerail.firebasestorage.app"
ARG NEXT_PUBLIC_FIREBASE_SENDER_ID="668261348718"
ARG NEXT_PUBLIC_FIREBASE_APP_ID="1:668261348718:web:4b9ff814c009c6a83dfd7f"
ARG NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
ARG NEXT_PUBLIC_ASSURERAIL_CONTACT_EMAIL=""
ARG NEXT_PUBLIC_ASSURERAIL_CUSTOMER_WORKSPACE_V1="off"
ARG NEXT_PUBLIC_ASSURERAIL_CUSTOMER_OPERATIONS_V1="off"
ARG NEXT_PUBLIC_ASSURERAIL_HOSTED_ALPHA_V1="off"
ARG NEXT_PUBLIC_ASSURERAIL_INSTITUTIONAL_PRODUCT_V1="off"
ARG NEXT_PUBLIC_ASSURERAIL_DA_PRODUCT_V1="off"
ARG NEXT_PUBLIC_ASSURERAIL_PTC_PRODUCT_V1="off"
ARG NEXT_PUBLIC_ASSURERAIL_LIFECYCLE_PRODUCT_V1="off"
ARG NEXT_PUBLIC_ASSURERAIL_PRIMARY_VENUE_PRODUCT_V1="off"
ARG NEXT_PUBLIC_ASSURERAIL_SECONDARY_PRODUCT_V1="off"
ARG NEXT_PUBLIC_ASSURERAIL_TOKENISED_PRODUCT_V1="off"
ARG NEXT_PUBLIC_ASSURERAIL_ENTERPRISE_INTEGRATION_V1="off"
ARG NEXT_PUBLIC_ASSURERAIL_PRODUCTION_SCALE_V1="off"
ARG NEXT_PUBLIC_ASSURERAIL_GUIDED_JOURNEY_V1="off"
ARG NEXT_PUBLIC_ASSURERAIL_SANDBOX_V1="off"
ENV NEXT_PUBLIC_ASSURERAIL_VENUE_URL=$NEXT_PUBLIC_ASSURERAIL_VENUE_URL \
    NEXT_PUBLIC_FIREBASE_API_KEY=$NEXT_PUBLIC_FIREBASE_API_KEY \
    NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN \
    NEXT_PUBLIC_FIREBASE_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_PROJECT_ID \
    NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=$NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET \
    NEXT_PUBLIC_FIREBASE_SENDER_ID=$NEXT_PUBLIC_FIREBASE_SENDER_ID \
    NEXT_PUBLIC_FIREBASE_APP_ID=$NEXT_PUBLIC_FIREBASE_APP_ID \
    NEXT_PUBLIC_RECAPTCHA_SITE_KEY=$NEXT_PUBLIC_RECAPTCHA_SITE_KEY \
    NEXT_PUBLIC_ASSURERAIL_CONTACT_EMAIL=$NEXT_PUBLIC_ASSURERAIL_CONTACT_EMAIL \
    NEXT_PUBLIC_ASSURERAIL_CUSTOMER_WORKSPACE_V1=$NEXT_PUBLIC_ASSURERAIL_CUSTOMER_WORKSPACE_V1 \
    NEXT_PUBLIC_ASSURERAIL_CUSTOMER_OPERATIONS_V1=$NEXT_PUBLIC_ASSURERAIL_CUSTOMER_OPERATIONS_V1 \
    NEXT_PUBLIC_ASSURERAIL_HOSTED_ALPHA_V1=$NEXT_PUBLIC_ASSURERAIL_HOSTED_ALPHA_V1 \
    NEXT_PUBLIC_ASSURERAIL_INSTITUTIONAL_PRODUCT_V1=$NEXT_PUBLIC_ASSURERAIL_INSTITUTIONAL_PRODUCT_V1 \
    NEXT_PUBLIC_ASSURERAIL_DA_PRODUCT_V1=$NEXT_PUBLIC_ASSURERAIL_DA_PRODUCT_V1 \
    NEXT_PUBLIC_ASSURERAIL_PTC_PRODUCT_V1=$NEXT_PUBLIC_ASSURERAIL_PTC_PRODUCT_V1 \
    NEXT_PUBLIC_ASSURERAIL_LIFECYCLE_PRODUCT_V1=$NEXT_PUBLIC_ASSURERAIL_LIFECYCLE_PRODUCT_V1 \
    NEXT_PUBLIC_ASSURERAIL_PRIMARY_VENUE_PRODUCT_V1=$NEXT_PUBLIC_ASSURERAIL_PRIMARY_VENUE_PRODUCT_V1 \
    NEXT_PUBLIC_ASSURERAIL_SECONDARY_PRODUCT_V1=$NEXT_PUBLIC_ASSURERAIL_SECONDARY_PRODUCT_V1 \
    NEXT_PUBLIC_ASSURERAIL_TOKENISED_PRODUCT_V1=$NEXT_PUBLIC_ASSURERAIL_TOKENISED_PRODUCT_V1 \
    NEXT_PUBLIC_ASSURERAIL_ENTERPRISE_INTEGRATION_V1=$NEXT_PUBLIC_ASSURERAIL_ENTERPRISE_INTEGRATION_V1 \
    NEXT_PUBLIC_ASSURERAIL_PRODUCTION_SCALE_V1=$NEXT_PUBLIC_ASSURERAIL_PRODUCTION_SCALE_V1 \
    NEXT_PUBLIC_ASSURERAIL_GUIDED_JOURNEY_V1=$NEXT_PUBLIC_ASSURERAIL_GUIDED_JOURNEY_V1 \
    NEXT_PUBLIC_ASSURERAIL_SANDBOX_V1=$NEXT_PUBLIC_ASSURERAIL_SANDBOX_V1 \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build --workspace=@assurerail/web

FROM base AS runner
ENV NODE_ENV=production \
    PORT=3007 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=installer /repo/apps/assurerail/.next/standalone ./
COPY --from=installer /repo/apps/assurerail/.next/static ./apps/assurerail/.next/static
COPY --from=installer /repo/apps/assurerail/public ./apps/assurerail/public
USER node
EXPOSE 3007
CMD ["node", "apps/assurerail/server.js"]
